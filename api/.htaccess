# Blokir akses langsung ke file konfigurasi privat
<Files "config.php">
  order allow,deny
  deny from all
</Files>

# Protek: tool setup hanya boleh dijalankan saat migrasi, token selain itu nonaktif
<Files "setup_db.php">
  order allow,deny
  deny from all
</Files>

# Matikan daftar direktori pada folder api
Options -Indexes
# Header keamanan dasar (bila mod_headers aktif; aman bila tidak)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
