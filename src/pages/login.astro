---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<BaseLayout title="Login · Portal Materi Basis Data UNIPI" description="Masuk portal mahasiswa untuk mengakses materi dan progres belajar">
  <Sidebar slot="sidebar" />

  <div class="login-page">
    <div class="login-card">
      <div class="login-head">
        <img src="/logo-unipi.png" alt="Logo Universitas Persatuan Islam (UNIPI)" class="login-logo" width="56" height="56" />
        <h1 class="login-title">Masuk Portal</h1>
        <p class="login-sub" id="loginSub">Akses materi, kuis, dan pantau progres belajar Anda.</p>
      </div>

      <form id="loginForm" class="login-form" autocomplete="on" novalidate>
        <div class="field">
          <label for="loginUsername" class="field__label">NIM / NIP</label>
          <div class="field__body">
            <span class="field__icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </span>
            <input type="text" id="loginUsername" class="field__input" placeholder="26105001" autocomplete="username" spellcheck="false" />
          </div>
        </div>

        <div class="field">
          <label for="loginPassword" class="field__label">Password</label>
          <div class="field__body">
            <span class="field__icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </span>
            <input type="password" id="loginPassword" class="field__input" placeholder="••••••••" autocomplete="current-password" />
            <button type="button" id="togglePass" class="field__toggle" aria-label="Tampilkan password">
              <svg id="eyeOpen" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg id="eyeClosed" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19M14.12 14.12a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>
          <p class="field__hint">Password awal = NIM Anda. Disarankan diganti setelah login pertama.</p>
        </div>

        <p class="login-msg" id="loginError" role="alert"></p>

        <button type="submit" class="login-btn" id="loginBtn">
          <span id="loginBtnText">Masuk</span>
        </button>
        <a class="login-back" href="/">← Kembali ke beranda</a>
      </form>

      <div class="login-info">
        <strong>Belum punya akun?</strong>
        <p>
          Akun didaftarkan oleh administrator. Jika belum punya akun,
          hubungi dosen pengampu atau admin portal. Data mahasiswa
          dapat diimpor dari panel admin.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .login-page {
    display: flex;
    justify-content: center;
    padding: 16px 0;
  }

  .login-card {
    width: 100%;
    max-width: 440px;
    background: var(--card);
    box-shadow: var(--neu-shadow);
    border-radius: 18px;
    padding: 34px 32px 28px;
  }

  .login-head { text-align: center; margin-bottom: 24px; }
  .login-logo {
    border-radius: 50%;
    box-shadow: var(--neu-shadow-sm);
    margin-bottom: 14px;
  }
  .login-title {
    font-family: var(--font-display);
    font-size: 24px;
    color: var(--navy-800);
    margin: 0 0 6px;
  }
  .login-sub {
    font-size: 13.5px;
    color: var(--ink-soft);
    margin: 0;
  }

  .field { margin-bottom: 18px; }
  .field__label {
    display: block;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--navy-700);
    margin: 0 0 6px 4px;
  }
  .field__body {
    position: relative;
    display: flex;
    align-items: center;
  }
  .field__icon {
    position: absolute;
    left: 14px;
    color: var(--ink-soft);
    display: flex;
    pointer-events: none;
  }
  .field__input {
    width: 100%;
    padding: 13px 46px 13px 42px;
    border: none;
    border-radius: 12px;
    background: var(--card);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 14px;
    outline: none;
    box-shadow: var(--neu-inset-sm);
    transition: box-shadow 0.2s;
  }
  .field__input::placeholder { color: #A8A294; }
  .field__input:focus {
    box-shadow: var(--neu-inset-sm), 0 0 0 2px var(--teal-500);
  }
  .field__toggle {
    position: absolute;
    right: 8px;
    width: 34px;
    height: 34px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s, background 0.2s;
  }
  .field__toggle:hover { color: var(--navy-700); background: rgba(0,0,0,.05); }
  .field__hint {
    font-size: 11.5px;
    color: var(--ink-soft);
    margin: 6px 0 0 4px;
  }

  .login-btn {
    width: 100%;
    padding: 13px;
    border: none;
    border-radius: 12px;
    background: var(--navy-700);
    color: #fff;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: var(--neu-shadow-sm);
    transition: box-shadow .2s, transform .05s;
  }
  .login-btn:hover { box-shadow: var(--neu-shadow-sm), inset 2px 2px 4px rgba(0,0,0,.18); }
  .login-btn:active { box-shadow: var(--neu-inset-sm); transform: translateY(1px); }
  .login-btn:disabled { opacity: .6; cursor: wait; }

  .login-back {
    display: block;
    text-align: center;
    margin-top: 14px;
    font-size: 12px;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .login-back:hover { color: var(--navy-700); }

  .login-msg {
    min-height: 18px;
    font-size: 13px;
    margin: 0 0 12px;
    text-align: center;
  }
  .login-msg.error { color: #b03a2e; font-weight: 600; }
  .login-msg.ok { color: #1F5F4B; font-weight: 600; }

  .login-info {
    margin-top: 22px;
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--teal-100);
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--navy-800);
  }
  .login-info strong {
    display: block;
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--navy-700);
    margin-bottom: 4px;
  }
  .login-info p { margin: 0; }
</style>

<script is:inline>
  (function () {
    var form = document.getElementById('loginForm');
    var errEl = document.getElementById('loginError');
    var btn = document.getElementById('loginBtn');
    var btnText = document.getElementById('loginBtnText');
    var pass = document.getElementById('loginPassword');

    function finalNext() {
      var n = new URLSearchParams(location.search).get('next');
      if (n && n.indexOf('/') === 0 && n.indexOf('//') !== 0) return n;
      return '/';
    }

    // toggle password
    document.getElementById('togglePass').addEventListener('click', function () {
      var show = pass.type === 'password';
      pass.type = show ? 'text' : 'password';
      document.getElementById('eyeOpen').style.display = show ? 'none' : '';
      document.getElementById('eyeClosed').style.display = show ? '' : 'none';
    });

    function setMsg(text, kind) {
      errEl.textContent = text || '';
      errEl.className = 'login-msg' + (kind ? ' ' + kind : '');
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var u = document.getElementById('loginUsername').value.trim();
      var p = pass.value;
      if (!u || !p) { setMsg('Isi NIM/NIP dan password Anda.', 'error'); return; }

      btn.disabled = true;
      btnText.textContent = 'Memeriksa…';
      setMsg('');

      if (typeof window.APIAuth === 'undefined') {
        setMsg('Modul autentikasi sedang dimuat. Muat ulang halaman.', 'error');
        resetBtn();
        return;
      }

      window.APIAuth.login(u, p).then(function (res) {
        if (res && res.logged_in) {
          setMsg('Berhasil masuk! Mengalihkan…', 'ok');
          setTimeout(function () { location.href = finalNext(); }, 400);
          return;
        }
        setMsg((res && res.error) || 'Login gagal.', 'error');
        resetBtn();
        pass.focus();
        pass.select();
      });
    });

    function resetBtn() {
      btn.disabled = false;
      btnText.textContent = 'Masuk';
    }

    // sudah login? arahkan langsung
    if (window.APIAuth) {
      window.APIAuth.me().then(function (p) {
        if (p && p.logged_in) location.href = finalNext();
      });
    }

    // fokus otomatis
    setTimeout(function () { document.getElementById('loginUsername').focus(); }, 100);

    // petunjuk bila datang dari perlindungan admin
    if (new URLSearchParams(location.search).get('type') === 'admin') {
      var sub = document.getElementById('loginSub');
      if (sub) { sub.textContent = 'Masuk dengan akun admin untuk membuka panel admin.'; }
    }
  })();
</script>