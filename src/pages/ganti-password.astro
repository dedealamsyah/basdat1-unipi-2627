---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<BaseLayout title="Ganti Password · Portal Basis Data UNIPI" description="Wajib mengganti password sebelum menggunakan portal">
  <Sidebar slot="sidebar" />

  <div class="login-page">
    <div class="login-card">
      <div class="login-head">
        <img src="/logo-unipi.png" alt="Logo Universitas Persatuan Islam (UNIPI)" class="login-logo" width="56" height="56" />
        <h1 class="login-title">Ganti Password</h1>
        <p class="login-sub" id="cpSub">Anda wajib mengganti password default sebelum melanjutkan.</p>
      </div>

      <form id="cpForm" class="login-form" autocomplete="on" novalidate>
        <div class="field">
          <label for="cpOld" class="field__label">Password Lama</label>
          <div class="field__body">
            <span class="field__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
            <input type="password" id="cpOld" class="field__input" placeholder="••••••••" autocomplete="current-password" />
          </div>
        </div>

        <div class="field">
          <label for="cpNew" class="field__label">Password Baru</label>
          <div class="field__body">
            <span class="field__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
            <input type="password" id="cpNew" class="field__input" placeholder="Minimal 8 karakter" autocomplete="new-password" />
          </div>
          <p class="field__hint">Minimal 8 karakter, campur huruf/angka. Jangan gunakan NIM Anda.</p>
        </div>

        <div class="field">
          <label for="cpNew2" class="field__label">Ulangi Password Baru</label>
          <div class="field__body">
            <span class="field__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg></span>
            <input type="password" id="cpNew2" class="field__input" placeholder="••••••••" autocomplete="new-password" />
          </div>
        </div>

        <p class="login-msg" id="cpError" role="alert"></p>

        <button type="submit" class="login-btn" id="cpBtn"><span id="cpBtnText">Simpan Password Baru</span></button>
        <a class="login-back" id="cpBack" href="/">← Batal &amp; kembali</a>
      </form>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .login-page { display: flex; justify-content: center; padding: 16px 0; }
  .login-card { width: 100%; max-width: 440px; background: var(--card); box-shadow: var(--neu-shadow); border-radius: 18px; padding: 34px 32px 28px; }
  .login-head { text-align: center; margin-bottom: 24px; }
  .login-logo { border-radius: 50%; box-shadow: var(--neu-shadow-sm); margin-bottom: 14px; }
  .login-title { font-family: var(--font-display); font-size: 24px; color: var(--navy-800); margin: 0 0 6px; }
  .login-sub { font-size: 13.5px; color: var(--ink-soft); margin: 0; }
  .field { margin-bottom: 18px; }
  .field__label { display: block; font-family: var(--font-body); font-size: 11px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--navy-700); margin: 0 0 6px 4px; }
  .field__body { position: relative; display: flex; align-items: center; }
  .field__icon { position: absolute; left: 14px; color: var(--ink-soft); display: flex; pointer-events: none; }
  .field__input { width: 100%; padding: 13px 14px 13px 42px; border: none; border-radius: 12px; background: var(--card); color: var(--ink); font-family: var(--font-body); font-size: 14px; outline: none; box-shadow: var(--neu-inset-sm); transition: box-shadow 0.2s; }
  .field__input::placeholder { color: #A8A294; }
  .field__input:focus { box-shadow: var(--neu-inset-sm), 0 0 0 2px var(--teal-500); }
  .field__hint { font-size: 11.5px; color: var(--ink-soft); margin: 6px 0 0 4px; }
  .login-btn { width: 100%; padding: 13px; border: none; border-radius: 12px; background: var(--navy-700); color: #fff; font-family: var(--font-body); font-size: 14px; font-weight: 700; cursor: pointer; box-shadow: var(--neu-shadow-sm); transition: box-shadow .2s, transform .05s; }
  .login-btn:hover { box-shadow: var(--neu-shadow-sm), inset 2px 2px 4px rgba(0,0,0,.18); }
  .login-btn:disabled { opacity: .6; cursor: wait; }
  .login-back { display: block; text-align: center; margin-top: 14px; font-size: 12px; color: var(--ink-soft); text-decoration: none; }
  .login-back:hover { color: var(--navy-700); }
  .login-msg { min-height: 18px; font-size: 13px; margin: 0 0 12px; text-align: center; }
  .login-msg.error { color: #b03a2e; font-weight: 600; }
  .login-msg.ok { color: #1F5F4B; font-weight: 600; }
</style>

<script is:inline>
  (function () {
    var form = document.getElementById('cpForm');
    var errEl = document.getElementById('cpError');
    var btn = document.getElementById('cpBtn');
    var btnText = document.getElementById('cpBtnText');

    function finalNext() {
      var n = new URLSearchParams(location.search).get('next');
      if (n && n.indexOf('/') === 0 && n.indexOf('//') !== 0) return n;
      return '/';
    }
    function setMsg(t, k) { errEl.textContent = t || ''; errEl.className = 'login-msg' + (k ? ' ' + k : ''); }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var oldP = document.getElementById('cpOld').value;
      var newP = document.getElementById('cpNew').value;
      var newP2 = document.getElementById('cpNew2').value;

      if (!oldP || !newP || !newP2) { setMsg('Lengkapi semua kolom.', 'error'); return; }
      if (newP.length < 8) { setMsg('Password baru minimal 8 karakter.', 'error'); return; }
      if (newP !== newP2) { setMsg('Konfirmasi password tidak cocok.', 'error'); return; }

      btn.disabled = true;
      btnText.textContent = 'Menyimpan…';
      setMsg('');

      if (typeof window.APIAuth === 'undefined') {
        setMsg('Modul autentikasi sedang dimuat. Muat ulang halaman.', 'error');
        btn.disabled = false; btnText.textContent = 'Simpan Password Baru';
        return;
      }

      window.APIAuth.changePassword(oldP, newP).then(function (res) {
        if (res && res.ok) {
          setMsg('Password berhasil diganti! Mengalihkan…', 'ok');
          setTimeout(function () { location.href = finalNext(); }, 600);
          return;
        }
        setMsg((res && res.error) || 'Gagal mengganti password.', 'error');
        btn.disabled = false;
        btnText.textContent = 'Simpan Password Baru';
      });
    });

    // belum login? ke halaman login
    if (window.APIAuth) {
      window.APIAuth.me().then(function (p) {
        if (!p || !p.logged_in) location.href = '/login?next=' + encodeURIComponent('/ganti-password/');
      });
    }
  })();
</script>