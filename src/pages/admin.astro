---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<BaseLayout title="Admin · Dashboard Progres & Nilai · Basis Data UNIPI" description="Panel admin: progres belajar, nilai, dan pengelolaan akun">
  <Sidebar slot="sidebar" />

  <div class="contentHeader">
    <div class="eyebrow">PANEL ADMIN</div>
    <h1 class="pageTitle">Dashboard Administrasi</h1>
    <p class="pageSubtitle">Pantau progres belajar, nilai mahasiswa, impor akun, dan kelola menu pertemuan dalam satu tempat.</p>
    <div id="adminStatus" class="muted"></div>
  </div>

  <!-- MODE MENGAJAR -->
  <section class="block mengajar">
    <div class="section-head">
      <h2 class="section-title"><span class="section-badge">▶</span> Mode Mengajar &amp; Presentasi</h2>
      <span class="muted">Presentasikan materi langsung di kelas, slide per bagian dengan proyektor</span>
    </div>
    <p class="muted" style="font-size:12px; margin-top:2px;">
      Klik <b>Presentasikan</b> untuk membuka materi pertemuan dalam mode layar penuh
      (navigasi panah, daftar slide, fullscreen). Materi dibagi otomatis per bagian.
    </p>
    <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:12px;">
      <a class="btn-sim" style="background:var(--amber-400); color:#4a3700; text-decoration:none;" href="/timeline">Lihat Timeline Perkuliahan</a>
      <span class="muted" style="align-self:center; font-size:12px;">Peta 16 minggu dari RPS — tampil untuk mahasiswa sebagai infografik.</span>
    </div>
    <div class="mengajar__grid" id="mengajarGrid">
      <p class="muted">Memuat…</p>
    </div>
  </section>

  <!-- STATISTIK -->
  <section class="block">
    <div class="section-head">
      <h2 class="section-title"><span class="section-badge">1</span> Ringkasan</h2>
      <span class="muted">Pembaruan otomatis dari data terkini</span>
    </div>

    <div class="stat-grid" id="statGrid">
      <div class="stat-card stat-card--gold">
        <span class="stat-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
        <span class="stat-num" id="stTotal">–</span>
        <span class="stat-label">Mahasiswa Terdaftar</span>
      </div>
      <div class="stat-card stat-card--green">
        <span class="stat-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        </span>
        <span class="stat-num" id="stProgres">–</span>
        <span class="stat-label">Rata-rata Progres</span>
      </div>
      <div class="stat-card stat-card--navy">
        <span class="stat-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10M18 20V4M6 20v-4"/></svg>
        </span>
        <span class="stat-num" id="stNilai">–</span>
        <span class="stat-label">Rata-rata Nilai</span>
      </div>
      <div class="stat-card stat-card--amber">
        <span class="stat-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </span>
        <span class="stat-num" id="stTuntas">–</span>
        <span class="stat-label">Tuntas 100%</span>
      </div>
    </div>

    <div class="two-col">
      <div>
        <h3 class="mini-title">Rekap per Kelas</h3>
        <div id="kelasBox" class="kelas-grid"><p class="muted">Memuat…</p></div>
      </div>
      <div>
        <h3 class="mini-title">Distribusi Nilai</h3>
        <div id="distBox" class="dist-box"><p class="muted">Memuat…</p></div>
      </div>
    </div>
  </section>

  <!-- FILTER -->
  <section class="block">
    <div class="section-head">
      <h2 class="section-title"><span class="section-badge">2</span> Pencarian &amp; Filter</h2>
    </div>
    <div class="filter-grid">
      <div class="filter-item">
        <label class="filter-label">Pencarian</label>
        <input type="text" id="qNim" class="wks-input" placeholder="NIM atau nama…" />
      </div>
      <div class="filter-item">
        <label class="filter-label">Kelas</label>
        <select id="qKelas" class="wks-input">
          <option value="">Semua kelas</option>
        </select>
      </div>
      <div class="filter-item">
        <label class="filter-label">Progres</label>
        <select id="qProgres" class="wks-input">
          <option value="">Semua progres</option>
          <option value="tuntas">Tuntas 100%</option>
          <option value="belum">Belum tuntas</option>
        </select>
      </div>
      <div class="filter-item">
        <label class="filter-label">Huruf</label>
        <select id="qHuruf" class="wks-input">
          <option value="">Semua huruf</option>
          <option value="A">A</option>
          <option value="AB">AB</option>
          <option value="B">B</option>
          <option value="BC">BC</option>
          <option value="C">C</option>
          <option value="D">D</option>
          <option value="E">E</option>
          <option value="-">Belum ada</option>
        </select>
      </div>
      <div class="filter-item filter-item--btn">
        <label class="filter-label">&nbsp;</label>
        <button class="btn-sim" id="resetFilter" style="background:var(--navy-800); width:100%;">Reset Filter</button>
      </div>
    </div>
  </section>

  <!-- KELOLA PERTEMUAN -->
  <section class="block">
    <div class="section-head">
      <h2 class="section-title"><span class="section-badge">3</span> Kelola Menu Pertemuan</h2>
      <span class="muted" style="font-size:11.5px;">Perubahan langsung tampil di portal tanpa rebuild.</span>
    </div>
    <p class="muted" style="font-size:12px; margin-top:2px;">
      Edit judul, sub-judul, posisi, alokasi, bobot, dan status tampil. Kosongkan centang <b>Tampil</b> untuk menyembunyikan.
    </p>
    <div style="overflow-x:auto; margin-top:12px;">
      <table class="dtable tbl-scroll" id="ptTable">
        <thead><tr><th>ID</th><th>Judul</th><th>Sub Judul</th><th>Posisi</th><th>Alokasi</th><th>Bobot</th><th>Tampil</th></tr></thead>
        <tbody id="ptTbody"><tr><td colspan="7" class="muted">Memuat…</td></tr></tbody>
      </table>
    </div>
    <div style="display:flex; gap:8px; margin-top:12px; flex-wrap:wrap;">
      <button class="btn-sim" id="ptSave" style="background:var(--green-600);">Simpan Menu Pertemuan</button>
      <button class="btn-sim" id="ptReset" style="background:var(--navy-800);">Batal Perubahan</button>
    </div>
    <p class="muted" id="ptMsg" style="margin-top:10px;"></p>
  </section>

  <!-- IMPORT -->
  <section class="block">
    <div class="section-head">
      <h2 class="section-title"><span class="section-badge">4</span> Import Akun Mahasiswa</h2>
    </div>
    <p class="muted" style="margin-bottom:8px;">
      Tempel data per baris format <code>nim,nama,kelas</code> — contoh
      <code>26105100,Fulan Bin Fulan,IF3A</code>. Password awal = NIM (wajib diganti saat login).
    </p>
    <textarea id="importText" class="wks-input" rows="6" spellcheck="false" placeholder="26105100,Fulan Bin Fulan,IF3A&#10;26105101,Fulanah Binti Fulan,IF3A"></textarea>
    <div style="display:flex; gap:8px; margin-top:10px; flex-wrap:wrap;">
      <button class="btn-sim" id="importBtn" style="background:var(--green-600);">Impor Mahasiswa</button>
      <button class="btn-sim" id="importResetPass" style="background:var(--navy-800);">Impor + Reset Password</button>
      <label class="btn-sim" style="background:var(--green-500); cursor:pointer; display:inline-block;">
        Import dari File CSV <input type="file" id="importCsv" accept=".csv,.txt" hidden />
      </label>
    </div>
    <p class="muted" id="importResult" style="margin-top:10px;"></p>
  </section>

  <!-- DAFTAR -->
  <section class="block">
    <div class="section-head">
      <h2 class="section-title"><span class="section-badge">5</span> Daftar Mahasiswa</h2>
      <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
        <span id="rowCount" class="muted" style="font-size:12px;"></span>
        <button class="btn-sim" id="exportCsv" style="background:var(--navy-800);">⬇ Ekspor CSV</button>
      </div>
    </div>
    <div style="overflow-x:auto;">
      <table class="dtable tbl-scroll tbl-sort" id="adminTable">
        <thead><tr>
          <th data-key="nim">NIM</th>
          <th data-key="nama">Nama</th>
          <th data-key="kelas">Kelas</th>
          <th data-key="done_count">Tuntas</th>
          <th data-key="persen">%</th>
          <th data-key="akhir">Nilai Akhir</th>
          <th data-key="huruf">Huruf</th>
          <th>Kelola</th>
        </tr></thead>
        <tbody id="adminTbody"><tr><td colspan="8" class="muted">Memuat…</td></tr></tbody>
      </table>
    </div>
  </section>

  <!-- EVALUASI -->
  <section class="block">
    <div class="section-head">
      <h2 class="section-title"><span class="section-badge">6</span> Evaluasi &amp; Integritas</h2>
      <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
        <label class="integ-filter">
          <input type="checkbox" id="onlyFlagged" />
          <span>Hanya yang terindikasi</span>
        </label>
        <span id="evalCount" class="muted" style="font-size:12px;"></span>
      </div>
    </div>
    <p class="muted" style="font-size:12px; margin-top:0;">
      Hasil evaluasi berkunci (1x percobaan, tanpa kunci jawaban) beserta deteksi integritas:
      salin/tempel, perpindahan tab, dan durasi terlalu singkat. Klik NIM untuk melihat detail.
    </p>
    <div style="overflow-x:auto; margin-top:12px;">
      <table class="dtable tbl-scroll" id="evalTable">
        <thead><tr>
          <th>NIM</th><th>Nama</th><th>Kelas</th><th>Ptm</th><th>Skor</th><th>Soal</th><th>Durasi</th>
          <th>Paste</th><th>Copy</th><th>Tab</th><th>Indikasi</th>
        </tr></thead>
        <tbody id="evalTbody"><tr><td colspan="11" class="muted">Memuat…</td></tr></tbody>
      </table>
    </div>
  </section>

  <!-- DETAIL -->
  <section class="block" id="detailBox" hidden>
    <div class="section-head">
      <h2 class="section-title"><span class="section-badge">›</span> <span id="detailTitle">Detail Progres</span></h2>
      <button class="btn-sim" id="detailClose" style="background:var(--navy-800);">Tutup Detail</button>
    </div>

    <div class="grade-box" id="gradeBox">
      <h3>Nilai Manual &amp; Akhir</h3>
      <div class="grade-grid">
        <label class="grade-item">Kuis Latihan (%)<span class="grade-readonly" id="gLatihan">–</span></label>
        <label class="grade-item">Evaluasi (%)<span class="grade-readonly" id="gEvaluasi">–</span></label>
        <label class="grade-item">Kuis Gabungan (%)<span class="grade-readonly" id="gKuis">–</span></label>
        <label class="grade-item">PTS
          <input type="number" min="0" max="100" id="gPts" class="wks-input" />
        </label>
        <label class="grade-item">UAS
          <input type="number" min="0" max="100" id="gUas" class="wks-input" />
        </label>
        <label class="grade-item">Tugas
          <input type="number" min="0" max="100" id="gTugas" class="wks-input" />
        </label>
        <label class="grade-item">Kehadiran
          <input type="number" min="0" max="100" id="gHadir" class="wks-input" />
        </label>
        <label class="grade-item">Nilai Akhir<span class="grade-readonly" id="gAkhir">–</span></label>
        <label class="grade-item">Huruf<span class="grade-readonly" id="gHuruf">–</span></label>
      </div>
      <p class="muted" style="font-size:11px; margin-top:8px;">
        Rumus: 40% kuis (rata-rata latihan + evaluasi) + 30% PTS + 30% UAS. Nilai akhir muncul saat ketiganya terisi.
      </p>
      <div style="display:flex; gap:8px; margin-top:8px; flex-wrap:wrap;">
        <button class="btn-sim" id="gradeSave" style="background:var(--green-600);">Simpan Nilai</button>
      </div>
    </div>

    <div style="overflow-x:auto; margin-top:16px;">
      <table class="dtable tbl-scroll" id="detailTable">
        <thead><tr><th>Pertemuan</th><th>Status</th><th>Skor Kuis</th><th>Attempts</th><th>Tgl Tuntas</th><th>Kelola</th></tr></thead>
        <tbody id="detailTbody"></tbody>
      </table>
    </div>

    <div style="overflow-x:auto; margin-top:16px;">
      <table class="dtable tbl-scroll" id="evalDetailTable">
        <thead><tr><th>Pertemuan</th><th>Skor Evaluasi</th><th>Soal</th><th>Durasi</th><th>Paste</th><th>Copy</th><th>Tab</th><th>Indikasi</th><th>Tgl Submit</th></tr></thead>
        <tbody id="evalDetailTbody"><tr><td colspan="9" class="muted">Belum ada evaluasi.</td></tr></tbody>
      </table>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .section-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 26px;
    border-radius: 8px;
    background: var(--navy-700);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    padding: 0 6px;
  }
  .mini-title {
    font-family: var(--font-display);
    font-size: 14px;
    color: var(--navy-700);
    margin: 0 0 10px;
  }
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 20px;
  }
  @media (max-width: 780px) { .two-col { grid-template-columns: 1fr; } }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
  }
  .stat-card {
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    border-radius: var(--radius);
    padding: 18px 16px;
    text-align: left;
    border-top: 3px solid var(--teal-400);
    position: relative;
  }
  .stat-card--gold { border-top-color: var(--teal-400); }
  .stat-card--green { border-top-color: var(--green-600); }
  .stat-card--navy { border-top-color: var(--navy-800); }
  .stat-card--amber { border-top-color: var(--amber-400); }
  .stat-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    color: #fff;
    margin-bottom: 10px;
  }
  .stat-card--gold .stat-icon { background: var(--teal-400); }
  .stat-card--green .stat-icon { background: var(--green-600); }
  .stat-card--navy .stat-icon { background: var(--navy-800); }
  .stat-card--amber .stat-icon { background: var(--amber-400); }
  .stat-num {
    display: block;
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
    margin-bottom: 6px;
  }
  .stat-label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .03em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .kelas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 10px;
  }
  .kelas-card {
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    border-radius: var(--radius);
    padding: 12px;
  }
  .kelas-card b {
    display: block;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
  }
  .kelas-card span {
    display: block;
    font-size: 11.5px;
    color: var(--ink-soft);
    margin-top: 2px;
  }

  .dist-box { display: flex; flex-direction: column; gap: 6px; }
  .dist-row {
    display: grid;
    grid-template-columns: 42px 1fr 34px;
    align-items: center;
    gap: 8px;
    font-size: 12px;
  }
  .dist-row span:first-child { font-family: var(--font-body); font-weight: 700; color: var(--ink); }
  .dist-bar { height: 14px; border-radius: 7px; background: var(--teal-100); overflow: hidden; }
  .dist-bar i {
    display: block; height: 100%; border-radius: 7px;
    background: linear-gradient(90deg, var(--navy-700), var(--green-600));
  }
  .dist-row span:last-child { text-align: right; color: var(--ink-soft); }

  .filter-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr auto;
    gap: 10px;
    align-items: end;
  }
  .filter-item { display: flex; flex-direction: column; gap: 4px; }
  .filter-item--btn { justify-self: end; }
  .filter-label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .filter-grid .wks-input { margin-bottom: 0; width: 100%; box-sizing: border-box; }
  @media (max-width: 880px) {
    .filter-grid { grid-template-columns: 1fr 1fr; }
    .filter-item--btn { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .filter-grid { grid-template-columns: 1fr; }
  }

  /* Tabel profesional */
  .tbl-scroll { max-height: 480px; }
  .tbl-scroll thead th { position: sticky; top: 0; z-index: 2; }
  .tbl-sort th { cursor: pointer; user-select: none; white-space: nowrap; }
  .tbl-sort th:hover { background: var(--navy-800); }
  .tbl-sort th.sorted { background: var(--teal-500); color: #221A02 !important; }

  .grade-box {
    margin-top: 4px;
    padding: 16px;
    border-radius: var(--radius);
    background: var(--teal-100);
    border: 1px solid rgba(176, 141, 28, .22);
  }
  .grade-box h3 {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 12px;
  }
  .grade-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 10px;
  }
  .grade-item {
    display: flex;
    flex-direction: column;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--navy-700);
    gap: 5px;
  }
  .grade-item .wks-input { margin-bottom: 0; }
  .grade-readonly {
    font-weight: 700;
    font-size: 16px;
    color: var(--ink);
    text-transform: none;
    padding: 9px 0;
  }

  .integ-filter {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 12px; color: var(--ink-soft); cursor: pointer;
  }
  .integ-filter input { accent-color: var(--red-600); }

  .mengajar__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
    margin-top: 14px;
  }
  .mengajar__card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: 14px 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: border-color .15s, box-shadow .15s, transform .08s;
  }
  .mengajar__card:hover { border-color: var(--navy-700); box-shadow: var(--shadow-md); }
  .mengajar__card.is-off { opacity: .55; }
  .mengajar__card-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .mengajar__num {
    font-family: var(--font-mono); font-size: 10.5px; font-weight: 700;
    letter-spacing: .05em; color: var(--amber-500); flex-shrink: 0;
  }
  .mengajar__title { font-weight: 700; font-size: 14px; color: var(--ink); line-height: 1.35; }
  .mengajar__sub { font-size: 11.5px; color: var(--ink-soft); line-height: 1.45; }
  .mengajar__sections { font-size: 11px; color: var(--ink-faint); margin-top: auto; }
  .mengajar__actions { display: flex; gap: 6px; margin-top: 4px; }
  .mengajar__actions .btn-sim { font-size: 12px; padding: 7px 10px; }

  .badge-flag {
    display: inline-block; font-size: 10px; font-weight: 700;
    padding: 2px 8px; border-radius: 20px;
    background: #FBEFDC; color: #8A4A29; border: 1px solid #E7A83D;
    margin: 1px 2px 1px 0;
  }
  .badge-flag--red { background: #FDE8E8; color: #B3261E; border-color: #F0A2A0; }
  .badge-ok { color: var(--green-600); font-weight: 700; font-size: 11px; }
</style>

<script is:inline>
  (function () {
    var csrfToken = null;

    function loadCsrf() {
      var load = function (payload) {
        if (payload && payload.csrf) csrfToken = payload.csrf;
      };
      if (typeof window.APIAuth !== 'undefined') {
        window.APIAuth.me().then(load);
      } else {
        fetch('/api/me.php', { credentials: 'same-origin', cache: 'no-store' })
          .then(function (r) { return r.json(); })
          .then(function (d) { load(d.data); })
          .catch(function () {});
      }
    }
    loadCsrf();

    var api = async function (path, opts) {
      opts = opts || {};
      opts.credentials = 'same-origin';
      opts.cache = 'no-store';
      var method = (opts.method || 'GET').toUpperCase();
      if (opts.body && typeof opts.body !== 'string') {
        opts.headers = Object.assign({}, opts.headers || {}, { 'Content-Type': 'application/json' });
        opts.body = JSON.stringify(opts.body);
      }
      if (method !== 'GET' && method !== 'HEAD' && csrfToken) {
        opts.headers = Object.assign({}, opts.headers || {}, { 'X-CSRF-Token': csrfToken });
      }
      if (typeof AbortController !== 'undefined' && !opts.signal) {
        var ctrl = new AbortController();
        setTimeout(function () { ctrl.abort(); }, 15000);
        opts.signal = ctrl.signal;
      }
      return fetch(path, opts).then(function (r) { return r.json(); });
    };

    var statusEl = document.getElementById('adminStatus');
    var tbody = document.getElementById('adminTbody');
    var dtbody = document.getElementById('detailTbody');
    var detailBox = document.getElementById('detailBox');
    var totalActive = 0;
    var kelasOptions = [];
    var allStudents = [];
    var allEvaluasi = [];
    var sortKey = 'nim';
    var sortDir = 1;

    function fail(msg) {
      statusEl.textContent = '';
      tbody.innerHTML = '<tr><td colspan="8" class="muted">' + msg + '</td></tr>';
    }

    function loadAdmin() {
      statusEl.textContent = 'Memuat data…';
      api('/api/admin.php').then(function (d) {
        if (!d.ok) {
          fail((d.error || 'Akses ditolak.') + ' – hubungi admin atau login sebagai admin.');
          return;
        }
        totalActive = d.data.total;
        statusEl.textContent = 'Total materi aktif: ' + totalActive + ' pertemuan.';
        allStudents = d.data.students;
        allEvaluasi = d.data.evaluasi || [];
        kelasOptions = [];
        allStudents.forEach(function (s) { if (s.kelas && kelasOptions.indexOf(s.kelas) === -1) kelasOptions.push(s.kelas); });
        fillKelas();
        renderEvaluasi();
        renderStats(allStudents);
        applyFilter();
      }).catch(function () {
        fail('Gagal memuat data. Pastikan API tersedia (/api/admin.php).');
      });
    }

    function renderStats(sts) {
      var total = sts.length;
      var sumP = 0, sumN = 0, nN = 0, tuntas = 0, dist = {}, kelas = {};
      sts.forEach(function (s) {
        sumP += s.persen;
        if (s.akhir != null) { sumN += s.akhir; nN++; }
        if (s.persen >= 100) tuntas++;
        var h = s.huruf || '–';
        dist[h] = (dist[h] || 0) + 1;
        var k = s.kelas || '?';
        kelas[k] = kelas[k] || { n: 0, sp: 0, sn: 0, nn: 0 };
        kelas[k].n++;
        kelas[k].sp += s.persen;
        if (s.akhir != null) { kelas[k].sn += s.akhir; kelas[k].nn++; }
      });
      document.getElementById('stTotal').textContent = total;
      document.getElementById('stProgres').textContent = total ? Math.round(sumP / total) + '%' : '–';
      document.getElementById('stNilai').textContent = nN ? Math.round(sumN / nN) : '–';
      document.getElementById('stTuntas').textContent = tuntas;

      // rekap kelas
      var kb = document.getElementById('kelasBox');
      kb.innerHTML = '';
      Object.keys(kelas).sort().forEach(function (k) {
        var d = kelas[k];
        var el = document.createElement('div');
        el.className = 'kelas-card';
        el.innerHTML = '<b>' + esc(k) + '</b><span>' + d.n + ' mhs · progres ' + Math.round(d.sp / d.n) + '%</span>' +
          (d.nn ? '<span>nilai Ø ' + Math.round(d.sn / d.nn) + '</span>' : '');
        kb.appendChild(el);
      });
      if (!Object.keys(kelas).length) kb.innerHTML = '<p class="muted">Belum ada data.</p>';

      // distribusi
      var order = ['A', 'AB', 'B', 'BC', 'C', 'D', 'E'];
      var box = document.getElementById('distBox');
      var max = 1;
      order.forEach(function (h) { if ((dist[h] || 0) > max) max = dist[h]; });
      box.innerHTML = '';
      order.forEach(function (h) {
        var c = dist[h] || 0;
        var row = document.createElement('div');
        row.className = 'dist-row';
        row.innerHTML = '<span>' + h + '</span><div class="dist-bar"><i style="width:' + (c / max * 100) + '%"></i></div><span>' + c + '</span>';
        box.appendChild(row);
      });
    }

    function fillKelas() {
      var sel = document.getElementById('qKelas');
      sel.innerHTML = '<option value="">Semua kelas</option>';
      kelasOptions.sort().forEach(function (k) {
        var o = document.createElement('option');
        o.value = k; o.textContent = k;
        sel.appendChild(o);
      });
    }

    function flagBits(f) { return [1, 2, 4].filter(function (b) { return (f & b) !== 0; }); }
    function flagLabels(f) {
      var map = { 1: 'Paste/Copy', 2: 'Pindah tab', 4: 'Terlalu cepat' };
      return flagBits(f).map(function (b) { return map[b]; });
    }
    function fmtDur(ms) {
      if (!ms) return '–';
      var s = Math.round(ms / 1000);
      var m = Math.floor(s / 60);
      return (m > 0 ? m + 'm ' : '') + (s % 60) + 's';
    }

    function renderEvaluasi() {
      var tbody = document.getElementById('evalTbody');
      var only = document.getElementById('onlyFlagged').checked;
      var rows = only ? allEvaluasi.filter(function (e) { return e.flagged > 0; }) : allEvaluasi;
      document.getElementById('evalCount').textContent = '(' + rows.length + ' dari ' + allEvaluasi.length + ' pengumpulan)';
      if (!rows.length) {
        tbody.innerHTML = '<tr><td colspan="11" class="muted">' + (allEvaluasi.length ? 'Tidak ada yang terindikasi.' : 'Belum ada evaluasi masuk.') + '</td></tr>';
        return;
      }
      tbody.innerHTML = '';
      rows.forEach(function (e) {
        var pct = e.total > 0 ? Math.round(e.skor / e.total * 100) : 0;
        var tr = document.createElement('tr');
        tr.innerHTML =
          '<td><a href="#" class="eval-nim" data-nim="' + esc(e.nim) + '">' + esc(e.nim) + '</a></td>' +
          '<td>' + esc(e.nama) + '</td>' +
          '<td>' + esc(e.kelas) + '</td>' +
          '<td>' + e.pertemuan_id + '</td>' +
          '<td><strong>' + e.skor + ' / ' + e.total + '</strong> (' + pct + '%)</td>' +
          '<td>' + e.jumlah_soal + '</td>' +
          '<td>' + fmtDur(e.time_spent_ms) + '</td>' +
          '<td>' + e.paste_count + '</td>' +
          '<td>' + e.copy_count + '</td>' +
          '<td>' + e.blur_count + '</td>' +
          '<td>' + (e.flagged ? flagLabels(e.flagged).map(function (l) { return '<span class="badge-flag badge-flag--red">' + esc(l) + '</span>'; }).join('') : '<span class="badge-ok">OK</span>') + '</td>';
        tbody.appendChild(tr);
      });
    }
    document.getElementById('onlyFlagged').addEventListener('change', renderEvaluasi);
    document.getElementById('evalTbody').addEventListener('click', function (e) {
      var a = e.target.closest('a[data-nim]');
      if (a) { e.preventDefault(); loadDetail(a.getAttribute('data-nim')); }
    });
    function applyFilter() {
      var q = (document.getElementById('qNim').value || '').toLowerCase().trim();
      var kl = document.getElementById('qKelas').value;
      var pr = document.getElementById('qProgres').value;
      var hr = document.getElementById('qHuruf').value;
      var rows = allStudents.filter(function (s) {
        if (kl && s.kelas !== kl) return false;
        if (pr === 'tuntas' && s.persen < 100) return false;
        if (pr === 'belum' && s.persen >= 100) return false;
        if (hr) {
          var curH = s.huruf || '–';
          if (hr === '-') { if (curH !== '–') return false; }
          else if (curH !== hr) return false;
        }
        if (q && s.nim.toLowerCase().indexOf(q) === -1 && s.nama.toLowerCase().indexOf(q) === -1) return false;
        return true;
      });
      renderStats(rows);
      document.getElementById('rowCount').textContent = '(' + rows.length + ' dari ' + allStudents.length + ')';
      renderRows(rows);
    }

    renderRows = function (students) {
      window.__students = students;
      var rows = students.slice().sort(function (a, b) {
        var x = a[sortKey], y = b[sortKey];
        if (typeof x === 'number' && typeof y === 'number') return (x - y) * sortDir;
        return String(x == null ? '' : x).localeCompare(String(y == null ? '' : y)) * sortDir;
      });
      if (!rows.length) {
        tbody.innerHTML = '<tr><td colspan="8" class="muted">Tidak ada data sesuai filter.</td></tr>';
        return;
      }
      tbody.innerHTML = '';
      rows.forEach(function (s) {
        var tr = document.createElement('tr');
        tr.innerHTML =
          '<td>' + esc(s.nim) + '</td>' +
          '<td>' + esc(s.nama) + '</td>' +
          '<td>' + esc(s.kelas) + '</td>' +
          '<td>' + s.done_count + ' / ' + s.total + '</td>' +
          '<td>' + s.persen + '%</td>' +
          '<td>' + (s.akhir != null ? s.akhir : '–') + '</td>' +
          '<td>' + (s.huruf ? '<strong>' + esc(s.huruf) + '</strong>' : '–') + '</td>' +
          '<td><button class="btn-sim" data-view="' + esc(s.nim) + '" style="background:var(--navy-800);">Lihat</button> ' +
          '<button class="btn-sim" data-del="' + esc(s.nim) + '" style="background:var(--red-600);">Hapus</button></td>';
        tbody.appendChild(tr);
      });
    };

    function esc(s) {
      return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function loadDetail(nim) {
      detailBox.hidden = false;
      detailBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
      document.getElementById('detailTitle').textContent = 'Memuat detail ' + nim + '…';
      api('/api/admin.php?nim=' + encodeURIComponent(nim)).then(function (d) {
        if (!d.ok) { alert(d.error || 'Gagal memuat detail.'); detailBox.hidden = true; return; }
        document.getElementById('detailTitle').textContent = 'Detail Progres: ' + nim;
        window.__curNim = nim;
        var n = d.data.nilai || {};
        document.getElementById('gLatihan').textContent = n.kuis_latihan != null ? n.kuis_latihan + '%' : '–';
        document.getElementById('gEvaluasi').textContent = n.kuis_evaluasi != null ? n.kuis_evaluasi + '%' : '–';
        document.getElementById('gKuis').textContent = n.kuis_pct != null ? n.kuis_pct + '%' : '–';
        document.getElementById('gPts').value = n.pts != null ? n.pts : '';
        document.getElementById('gUas').value = n.uas != null ? n.uas : '';
        document.getElementById('gTugas').value = n.tugas != null ? n.tugas : '';
        document.getElementById('gHadir').value = n.hadir != null ? n.hadir : '';
        document.getElementById('gAkhir').textContent = n.akhir != null ? n.akhir : '–';
        document.getElementById('gHuruf').textContent = n.huruf || '–';
        dtbody.innerHTML = '';
        d.data.progress.forEach(function (p) {
          var st = p.status;
          var stText = st === 'done' ? '<span class="st-done">✓ Tuntas</span>' : (st === 'open' ? 'Terbuka' : '<span class="st-locked">Terkunci</span>');
          var tr = document.createElement('tr');
          tr.innerHTML =
            '<td>Pertemuan ' + p.pertemuan_id + '</td>' +
            '<td>' + stText + '</td>' +
            '<td>' + p.quiz_score + (p.quiz_total ? ' / ' + p.quiz_total : '') + '</td>' +
            '<td>' + p.attempts + '</td>' +
            '<td>' + (p.completed_at ? p.completed_at.slice(0, 10) : '–') + '</td>' +
            '<td><button class="btn-sim" data-toggle="' + p.pertemuan_id + '" style="background:' + (st === 'done' ? 'var(--red-600);' : 'var(--green-600);') + '" data-nim="' + esc(nim) + '">' + (st === 'done' ? 'Batal' : 'Tandai Tuntas') + '</button></td>';
          dtbody.appendChild(tr);
        });
        var etb = document.getElementById('evalDetailTbody');
        var evs = d.data.evaluasi || [];
        if (!evs.length) {
          etb.innerHTML = '<tr><td colspan="9" class="muted">Belum ada evaluasi.</td></tr>';
        } else {
          etb.innerHTML = '';
          evs.forEach(function (e) {
            var pct = e.total > 0 ? Math.round(e.skor / e.total * 100) : 0;
            var tr = document.createElement('tr');
            tr.innerHTML =
              '<td>Pertemuan ' + e.pertemuan_id + '</td>' +
              '<td><strong>' + e.skor + ' / ' + e.total + '</strong> (' + pct + '%)</td>' +
              '<td>' + e.jumlah_soal + '</td>' +
              '<td>' + fmtDur(e.time_spent_ms) + '</td>' +
              '<td>' + e.paste_count + '</td>' +
              '<td>' + e.copy_count + '</td>' +
              '<td>' + e.blur_count + '</td>' +
              '<td>' + (e.flagged ? flagLabels(e.flagged).map(function (l) { return '<span class="badge-flag badge-flag--red">' + esc(l) + '</span>'; }).join('') : '<span class="badge-ok">OK</span>') + '</td>' +
              '<td>' + String(e.submitted_at || '').slice(0, 10) + '</td>';
            etb.appendChild(tr);
          });
        }
      }).catch(function () {
        alert('Gagal menghubungi API detail.');
        detailBox.hidden = true;
      });
    }

    tbody.addEventListener('click', function (e) {
      var btn = e.target.closest('button[data-view]');
      if (btn) { loadDetail(btn.getAttribute('data-view')); return; }
      var del = e.target.closest('button[data-del]');
      if (del) {
        var nim = del.getAttribute('data-del');
        if (!confirm('Hapus akun mahasiswa ' + nim + ' beserta progresnya?')) return;
        api('/api/delete_user.php', { method: 'POST', body: { nim: nim } }).then(function (d) {
          if (!d.ok) { alert(d.error || 'Gagal.'); return; }
          detailBox.hidden = true;
          loadAdmin();
        });
      }
    });

    dtbody.addEventListener('click', function (e) {
      var btn = e.target.closest('button[data-toggle]');
      if (!btn) return;
      var nim = btn.getAttribute('data-nim');
      var pid = parseInt(btn.getAttribute('data-toggle'), 10);
      var action = btn.textContent.indexOf('Batal') === 0 ? 'undone' : 'done';
      if (action === 'undone' && !confirm('Batal tuntas pertemuan ini untuk ' + nim + '?')) return;
      api('/api/unlock.php', { method: 'POST', body: { nim: nim, pertemuan_id: pid, action: action } }).then(function (d) {
        if (!d.ok) { alert(d.error || 'Gagal.'); return; }
        loadDetail(nim);
        loadAdmin();
      });
    });

    document.getElementById('detailClose').addEventListener('click', function () { detailBox.hidden = true; });

    document.getElementById('gradeSave').addEventListener('click', function () {
      var nim = window.__curNim;
      if (!nim) return;
      var comps = [{ k: 'pts', el: gEl('gPts') }, { k: 'uas', el: gEl('gUas') },
                   { k: 'tugas', el: gEl('gTugas') }, { k: 'hadir', el: gEl('gHadir') }];
      var btn = document.getElementById('gradeSave');
      btn.disabled = true; btn.textContent = 'Menyimpan…';
      var chain = Promise.resolve();
      comps.forEach(function (c) {
        chain = chain.then(function () {
          var v = c.el.value.trim();
          var nilai = v === '' ? -1 : parseInt(v, 10);
          return api('/api/grade.php', { method: 'POST', body: { nim: nim, komponen: c.k, nilai: isNaN(nilai) ? -1 : nilai } });
        });
      });
      chain.then(function (res) {
        btn.disabled = false; btn.textContent = 'Simpan Nilai';
        if (res && res.ok) { loadDetail(nim); loadAdmin(); }
        else { alert((res && res.error) || 'Gagal menyimpan.'); }
      });
    });
    function gEl(id) { return document.getElementById(id); }

    document.getElementById('exportCsv').addEventListener('click', function () {
      var sts = window.__students || allStudents;
      if (!sts.length) { alert('Belum ada data untuk diekspor.'); return; }
      var rows = [['NIM', 'Nama', 'Kelas', 'Tuntas', 'Total', 'Persen', 'NilaiAkhir', 'Huruf']];
      sts.forEach(function (s) {
        rows.push([s.nim, s.nama, s.kelas, s.done_count, s.total, s.persen + '%', s.akhir == null ? '' : s.akhir, s.huruf || '']);
      });
      var csv = rows.map(function (r) {
        return r.map(function (c) {
          var s = String(c);
          return (s.indexOf(',') !== -1 || s.indexOf('"') !== -1) ? '"' + s.replace(/"/g, '""') + '"' : s;
        }).join(',');
      }).join('\r\n');
      var blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'nilai-' + new Date().toISOString().slice(0, 10) + '.csv';
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      URL.revokeObjectURL(a.href);
    });

    function doImport() {
      var text = document.getElementById('importText').value.trim();
      if (!text) { document.getElementById('importResult').textContent = 'Isi kolom data dulu.'; return; }
      document.getElementById('importResult').textContent = 'Mengimpor…';
      api('/api/import_users.php', { method: 'POST', body: text, headers: { 'Content-Type': 'text/plain' } }).then(function (d) {
        if (!d.ok) { document.getElementById('importResult').textContent = 'Gagal: ' + (d.error || '?'); return; }
        document.getElementById('importResult').textContent =
          'Selesai: ' + d.data.imported + ' baru, ' + d.data.updated_existing + ' diperbarui. Password awal = NIM.';
        document.getElementById('importText').value = '';
        loadAdmin();
      });
    }
    document.getElementById('importBtn').addEventListener('click', function () { doImport(); });
    document.getElementById('importResetPass').addEventListener('click', function () {
      var text = document.getElementById('importText').value.trim();
      if (!text) { document.getElementById('importResult').textContent = 'Tempel data mahasiswa lalu klik impor + reset.'; return; }
      document.getElementById('importResult').textContent = 'Mengimpor + reset password…';
      api('/api/import_users.php?reset=1', { method: 'POST', body: text, headers: { 'Content-Type': 'text/plain' } }).then(function (d) {
        document.getElementById('importResult').textContent = d.ok
          ? 'Selesai: ' + d.data.imported + ' baru, ' + d.data.updated_existing + ' direset.'
          : 'Gagal: ' + (d.error || '?');
        document.getElementById('importText').value = '';
        loadAdmin();
      });
    });
    document.getElementById('importCsv').addEventListener('change', function (e) {
      var f = e.target.files && e.target.files[0];
      if (!f) return;
      var r = new FileReader();
      r.onload = function () {
        document.getElementById('importText').value = r.result;
        document.getElementById('importResult').textContent = 'File dibaca: klik "Impor Mahasiswa".';
      };
      r.readAsText(f);
      e.target.value = '';
    });

    document.getElementById('qNim').addEventListener('input', applyFilter);
    document.getElementById('qKelas').addEventListener('change', applyFilter);
    document.getElementById('qProgres').addEventListener('change', applyFilter);
    document.getElementById('qHuruf').addEventListener('change', applyFilter);
    document.getElementById('resetFilter').addEventListener('click', function () {
      document.getElementById('qNim').value = '';
      document.getElementById('qKelas').value = '';
      document.getElementById('qProgres').value = '';
      document.getElementById('qHuruf').value = '';
      applyFilter();
    });

    // sorting kolom
    document.querySelectorAll('#adminTable thead th[data-key]').forEach(function (th) {
      th.addEventListener('click', function () {
        var k = th.getAttribute('data-key');
        if (sortKey === k) { sortDir = -sortDir; } else { sortKey = k; sortDir = 1; }
        document.querySelectorAll('#adminTable thead th').forEach(function (t) { t.classList.remove('sorted'); });
        th.classList.add('sorted');
        applyFilter();
      });
    });

    var ptTbody = document.getElementById('ptTbody');
    var ptRows = [];
    function loadPertemuan() {
      ptTbody.innerHTML = '<tr><td colspan="7" class="muted">Memuat…</td></tr>';
      api('/api/pertemuan.php').then(function (d) {
        if (!d.ok) { ptTbody.innerHTML = '<tr><td colspan="7" class="muted">Gagal memuat.</td></tr>'; return; }
        ptRows = d.data.pertemuan; renderPt(); renderMengajar();
      });
    }
    function renderMengajar() {
      var grid = document.getElementById('mengajarGrid');
      if (!grid) return;
      grid.innerHTML = '';
      if (!ptRows.length) {
        grid.innerHTML = '<p class="muted">Belum ada data pertemuan.</p>';
        return;
      }
      ptRows.forEach(function (p) {
        var card = document.createElement('div');
        card.className = 'mengajar__card' + (p.aktif ? '' : ' is-off');
        var badge = p.aktif
          ? '<span class="chip chip--sm" style="background:var(--green-600); color:#fff;">AKTIF</span>'
          : '<span class="chip chip--sm" style="background:var(--ink-faint);">SEMBUNYI</span>';
        var metaBits = [];
        if (p.alokasi) metaBits.push('⏱ ' + esc(p.alokasi));
        if (p.bobot) metaBits.push('BOBOT ' + esc(p.bobot));
        if (p.cpmk) metaBits.push(esc(p.cpmk));
        card.innerHTML =
          '<div class="mengajar__card-top">' +
          '<span class="mengajar__num">PERTEMUAN ' + String(p.id).padStart(2, '0') + '</span>' + badge +
          '</div>' +
          '<div class="mengajar__title">' + esc(p.title || 'Belum berjudul') + '</div>' +
          (p.subtitle ? '<div class="mengajar__sub">' + esc(p.subtitle) + '</div>' : '') +
          (metaBits.length ? '<div class="mengajar__sections">' + metaBits.join(' · ') + '</div>' : '<div class="mengajar__sections">&nbsp;</div>') +
          '<div class="mengajar__actions">' +
          '<a class="btn-sim" style="background:var(--navy-700); flex:1; text-align:center; text-decoration:none;" href="/presentasi.php?p=' + p.id + '">▶ Presentasikan</a>' +
          '<a class="btn-sim" style="background:var(--green-600); flex:1; text-align:center; text-decoration:none;" href="/pertemuan/' + p.id + '">Buka Materi</a>' +
          '</div>';
        grid.appendChild(card);
      });
    }
    function renderPt() {
      ptTbody.innerHTML = '';
      ptRows.forEach(function (p) {
        var tr = document.createElement('tr');
        tr.setAttribute('data-ptid', p.id);
        tr.innerHTML =
          '<td>' + p.id + '</td>' +
          '<td><input type="text" data-f="title" value="' + esc(p.title) + '" style="width:100%;"></td>' +
          '<td><input type="text" data-f="subtitle" value="' + esc(p.subtitle) + '" style="width:100%;"></td>' +
          '<td><input type="number" data-f="posisi" value="' + p.posisi + '" style="width:60px;"></td>' +
          '<td><input type="text" data-f="alokasi" value="' + esc(p.alokasi) + '" style="width:100%;"></td>' +
          '<td><input type="text" data-f="bobot" value="' + esc(p.bobot) + '" style="width:70px;"></td>' +
          '<td style="text-align:center"><input type="checkbox" data-f="aktif" ' + (p.aktif ? 'checked' : '') + '></td>';
        tr.querySelector('input[data-f="aktif"]').style.width = 'auto';
        ptTbody.appendChild(tr);
      });
    }
    function collectPt() {
      var updates = [];
      ptTbody.querySelectorAll('tr[data-ptid]').forEach(function (tr) {
        var id = parseInt(tr.getAttribute('data-ptid'), 10);
        updates.push({
          id: id,
          title: tr.querySelector('[data-f="title"]').value,
          subtitle: tr.querySelector('[data-f="subtitle"]').value,
          posisi: parseInt(tr.querySelector('[data-f="posisi"]').value, 10) || 0,
          alokasi: tr.querySelector('[data-f="alokasi"]').value,
          bobot: tr.querySelector('[data-f="bobot"]').value,
          aktif: tr.querySelector('[data-f="aktif"]').checked ? 1 : 0
        });
      });
      return updates;
    }
    document.getElementById('ptSave').addEventListener('click', function () {
      var btn = document.getElementById('ptSave');
      var msg = document.getElementById('ptMsg');
      btn.disabled = true; btn.textContent = 'Menyimpan…';
      api('/api/pertemuan.php', { method: 'POST', body: { updates: collectPt() } }).then(function (d) {
        btn.disabled = false; btn.textContent = 'Simpan Menu Pertemuan';
        if (!d.ok) { msg.textContent = 'Gagal: ' + (d.error || '?'); return; }
        msg.textContent = 'Menu pertemuan tersimpan dan langsung tampil di portal.';
        ptRows = d.data.pertemuan; renderPt();
      });
    });
    document.getElementById('ptReset').addEventListener('click', function () {
      document.getElementById('ptMsg').textContent = '';
      loadPertemuan();
    });

    loadAdmin();
    loadPertemuan();
  })();
</script>