  }
  .ev-g { background: var(--green-100); color: var(--green-600); }
  .ev-a { background: #FBEFDC; color: #8A4A29; }
  .ev-r { background: #FDE8E8; color: #B3261E; }
  .ev-na { color: var(--ink-faint); text-align: center; }
  .ev-flag {
