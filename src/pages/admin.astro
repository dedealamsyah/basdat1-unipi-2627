</style>

<script is:inline>
  (function () {
    var csrfToken = null;
    var ERD_TEMPLATES = [];
    try { ERD_TEMPLATES = JSON.parse(document.getElementById('erdTemplatesJson').textContent); }
    catch (e) { ERD_TEMPLATES = []; }

    function loadCsrf() {
      var load = function (payload) {
        if (payload && payload.csrf) csrfToken = payload.csrf;
      };
      if (typeof window.APIAuth !== 'undefined') {
        window.APIAuth.me().then(load);
      } else {
        fetch('/api/me.php', { credentials: 'same-origin', cache: 'no-store' })
          .then(function (r) { return r.json(); })
          .then(function (d) { load(d.data); })
          .catch(function () {});
      }
    }
    loadCsrf();

    var api = async function (path, opts) {
      opts = opts || {};
      opts.credentials = 'same-origin';
      opts.cache = 'no-store';
      var method = (opts.method || 'GET').toUpperCase();
      if (opts.body && typeof opts.body !== 'string') {
        opts.headers = Object.assign({}, opts.headers || {}, { 'Content-Type': 'application/json' });
        opts.body = JSON.stringify(opts.body);
      }
      if (method !== 'GET' && method !== 'HEAD' && csrfToken) {
        opts.headers = Object.assign({}, opts.headers || {}, { 'X-CSRF-Token': csrfToken });
      }
      if (typeof AbortController !== 'undefined' && !opts.signal) {
        var ctrl = new AbortController();
        setTimeout(function () { ctrl.abort(); }, 15000);
        opts.signal = ctrl.signal;
      }
      return fetch(path, opts).then(function (r) { return r.json(); });
    };

    var statusEl = document.getElementById('adminStatus');
    var tbody = document.getElementById('adminTbody');
    var dtbody = document.getElementById('detailTbody');
    var detailBox = document.getElementById('detailBox');
    var totalActive = 0;
    var kelasOptions = [];
    var allStudents = [];
    var allEvaluasi = [];
    var evalByStudent = {};
    var allTugas = [];
    var sortKey = 'nim';
    var sortDir = 1;

    function fail(msg) {
      statusEl.textContent = '';
      tbody.innerHTML = '<tr><td colspan="8" class="muted">' + msg + '</td></tr>';
    }

    function loadAdmin() {
      statusEl.textContent = 'Memuat data…';
      api('/api/admin.php').then(function (d) {
        if (!d.ok) {
          fail((d.error || 'Akses ditolak.') + ' – hubungi admin atau login sebagai admin.');
          return;
        }
        totalActive = d.data.total;
        statusEl.textContent = 'Total materi aktif: ' + totalActive + ' pertemuan.';
        allStudents = d.data.students;
        allEvaluasi = d.data.evaluasi || [];
        evalByStudent = d.data.eval_by_student || {};
        allTugas = d.data.tugas || [];
        renderNilaiEval();
        renderTugas();
        kelasOptions = [];
        allStudents.forEach(function (s) { if (s.kelas && kelasOptions.indexOf(s.kelas) === -1) kelasOptions.push(s.kelas); });
        fillKelas();
        renderEvaluasi();
        renderStats(allStudents);
        applyFilter();
      }).catch(function () {
        fail('Gagal memuat data. Pastikan API tersedia (/api/admin.php).');
      });
    }

    function renderStats(sts) {
      var total = sts.length;
      var sumP = 0, sumN = 0, nN = 0, tuntas = 0, dist = {}, kelas = {};
      sts.forEach(function (s) {
        sumP += s.persen;
        if (s.akhir != null) { sumN += s.akhir; nN++; }
        if (s.persen >= 100) tuntas++;
        var h = s.huruf || '–';
        dist[h] = (dist[h] || 0) + 1;
        var k = s.kelas || '?';
        kelas[k] = kelas[k] || { n: 0, sp: 0, sn: 0, nn: 0 };
        kelas[k].n++;
        kelas[k].sp += s.persen;
        if (s.akhir != null) { kelas[k].sn += s.akhir; kelas[k].nn++; }
      });
      var kelasNames = Object.keys(kelas);
      document.getElementById('stTotal').textContent = total;
      setMeta('stTotalMeta', kelasNames.length ? kelasNames.length + ' kelas terdata' : 'belum ada kelas');
      document.getElementById('stProgres').textContent = total ? Math.round(sumP / total) + '%' : '–';
      setMeta('stProgresMeta', (total - tuntas) + ' mahasiswa belum tuntas');
      document.getElementById('stNilai').textContent = nN ? Math.round(sumN / nN) : '–';
      setMeta('stNilaiMeta', nN + ' dengan nilai akhir');
      document.getElementById('stTuntas').textContent = tuntas;
      setMeta('stTuntasMeta', tuntas + ' dari ' + total + ' mahasiswa');

      // rekap kelas
      var KCARDS = [
        { fg: 'var(--navy-700)', bg: 'var(--green-100)' },
        { fg: 'var(--amber-400)', bg: 'var(--amber-100)' },
        { fg: 'var(--teal-500)', bg: 'var(--teal-100)' },
        { fg: 'var(--green-600)', bg: 'var(--green-100)' },
        { fg: 'var(--red-600)', bg: 'var(--red-100)' }
      ];
      var kb = document.getElementById('kelasBox');
      kb.innerHTML = '';
      kelasNames.sort().forEach(function (k, i) {
        var d = kelas[k];
        var c = KCARDS[i % KCARDS.length];
        var rows = '<span class="kcard__row">Progres <b>' + Math.round(d.sp / d.n) + '%</b></span>';
        if (d.nn) rows += '<span class="kcard__row">Nilai Ø <b>' + Math.round(d.sn / d.nn) + '</b></span>';
        var el = document.createElement('div');
        el.className = 'kcard';
        el.innerHTML =
          '<span class="kcard__tag" style="background:' + c.bg + ';color:' + c.fg + ';">' + esc(k) + '</span>' +
          '<span class="kcard__val">' + d.n + '</span>' +
          '<span class="kcard__label">Mahasiswa</span>' +
          '<span class="kcard__rows">' + rows + '</span>';
        kb.appendChild(el);
      });
      if (!kelasNames.length) kb.innerHTML = '<p class="muted">Belum ada data.</p>';

      // distribusi
      var order = ['A', 'AB', 'B', 'BC', 'C', 'D', 'E'];
      var box = document.getElementById('distBox');
      var max = 1;
      order.forEach(function (h) { if ((dist[h] || 0) > max) max = dist[h]; });
      box.innerHTML = '';
      order.forEach(function (h) {
        var c = dist[h] || 0;
        var row = document.createElement('div');
        row.className = 'dist-row';
        row.innerHTML = '<span class="dist-letter">' + h + '</span><div class="dist-track"><i style="width:' + (c / max * 100) + '%"></i></div><span class="dist-count">' + c + '</span>';
        box.appendChild(row);
      });
    }
    function setMeta(id, txt) {
      var el = document.getElementById(id);
      if (el) el.textContent = txt;
    }

    function fillKelas() {
      var sel = document.getElementById('qKelas');
      sel.innerHTML = '<option value="">Semua kelas</option>';
      kelasOptions.sort().forEach(function (k) {
        var o = document.createElement('option');
        o.value = k; o.textContent = k;
        sel.appendChild(o);
      });
    }

    function flagBits(f) { return [1, 2, 4].filter(function (b) { return (f & b) !== 0; }); }
    function flagLabels(f) {
      var map = { 1: 'Paste/Copy', 2: 'Pindah tab', 4: 'Terlalu cepat' };
      return flagBits(f).map(function (b) { return map[b]; });
    }
    function fmtDur(ms) {
      if (!ms) return '–';
      var s = Math.round(ms / 1000);
      var m = Math.floor(s / 60);
      return (m > 0 ? m + 'm ' : '') + (s % 60) + 's';
    }

    function renderEvaluasi() {
      var tbody = document.getElementById('evalTbody');
      var only = document.getElementById('onlyFlagged').checked;
      var rows = only ? allEvaluasi.filter(function (e) { return e.flagged > 0; }) : allEvaluasi;
      document.getElementById('evalCount').textContent = '(' + rows.length + ' dari ' + allEvaluasi.length + ' pengumpulan)';
      if (!rows.length) {
        tbody.innerHTML = '<tr><td colspan="11" class="muted">' + (allEvaluasi.length ? 'Tidak ada yang terindikasi.' : 'Belum ada evaluasi masuk.') + '</td></tr>';
        return;
      }
      tbody.innerHTML = '';
      rows.forEach(function (e) {
        var pct = e.total > 0 ? Math.round(e.skor / e.total * 100) : 0;
        var tr = document.createElement('tr');
        tr.innerHTML =
          '<td><a href="#" class="eval-nim" data-nim="' + esc(e.nim) + '">' + esc(e.nim) + '</a></td>' +
          '<td>' + esc(e.nama) + '</td>' +
          '<td>' + esc(e.kelas) + '</td>' +
          '<td>' + e.pertemuan_id + '</td>' +
          '<td><strong>' + e.skor + ' / ' + e.total + '</strong> (' + pct + '%)</td>' +
          '<td>' + e.jumlah_soal + '</td>' +
          '<td>' + fmtDur(e.time_spent_ms) + '</td>' +
          '<td>' + e.paste_count + '</td>' +
          '<td>' + e.copy_count + '</td>' +
          '<td>' + e.blur_count + '</td>' +
          '<td>' + (e.flagged ? flagLabels(e.flagged).map(function (l) { return '<span class="badge-flag badge-flag--red">' + esc(l) + '</span>'; }).join('') : '<span class="badge-ok">OK</span>') + '</td>';
        tbody.appendChild(tr);
      });
    }

    // ===== Grid nilai evaluasi per pertemuan =====
    function renderNilaiEval() {
      var head = document.getElementById('nilaiEvalHead');
      var tb = document.getElementById('nilaiEvalTbody');
      if (!head || !tb) return;
      var cols = (ptRows || []).filter(function (p) { return !!p.aktif; })
        .sort(function (a, b) { return ((a.posisi || 99) - (b.posisi || 99)) || (a.id - b.id); });
      head.innerHTML = '<tr><th>Mahasiswa</th><th>Kelas</th>' +
        cols.map(function (p) { return '<th title="Evaluasi Pertemuan ' + p.id + '">P' + String(p.id).padStart(2, '0') + '</th>'; }).join('') +
        '<th>Rata Evaluasi</th></tr>';
      if (!allStudents.length) {
        tb.innerHTML = '<tr><td colspan="' + (cols.length + 3) + '" class="muted">Belum ada mahasiswa.</td></tr>';
        return;
      }
      var html = '';
      allStudents.forEach(function (s) {
        var evs = evalByStudent[s.nim] || {};
        html += '<tr>' +
          '<td>' + esc(s.nama) + '<span class="muted" style="display:block;font-size:11px;">' + esc(s.nim) + '</span></td>' +
          '<td>' + esc(s.kelas || '–') + '</td>';
        cols.forEach(function (p) {
          var e = evs[p.id];
          if (!e) { html += '<td class="ev-na">–</td>'; return; }
          var cls = e.pct >= 80 ? 'ev-g' : (e.pct >= 60 ? 'ev-a' : 'ev-r');
          html += '<td class="ev-td">' +
            '<span class="ev-cell ' + cls + '" title="Skor ' + e.skor + ' / ' + e.total + '">' + e.pct + '</span>' +
            (e.flagged ? '<i class="ev-flag" title="Terindikasi integritas"></i>' : '') +
            '</td>';
        });
        html += '<td>' + (s.eval_pct != null ? '<strong>' + s.eval_pct + '%</strong>' : '–') + '</td></tr>';
      });
      tb.innerHTML = html;
    }

    // ===== Pengumpulan tugas (tautan Google Drive) =====
    function renderTugas() {
      var tb = document.getElementById('tugasTbody');
      if (!tb) return;
      document.getElementById('tugasCount').textContent = '(' + allTugas.length + ' pengumpulan)';
      if (!allTugas.length) {
        tb.innerHTML = '<tr><td colspan="8" class="muted">Belum ada pengumpulan tugas.</td></tr>';
        return;
      }
      var html = '';
      allTugas.forEach(function (t) {
        var drive = t.drive_link || t.drive_file_id;
        html += '<tr>' +
          '<td>' + esc(t.nim) + '</td>' +
          '<td>' + esc(t.nama) + '</td>' +
          '<td>' + esc(t.kelas || '–') + '</td>' +
          '<td>P' + String(t.pertemuan_id).padStart(2, '0') + '</td>' +
          '<td>' + (t.drive_file_id
