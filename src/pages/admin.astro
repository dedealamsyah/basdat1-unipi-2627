            ? '<a class="btn-sim" style="font-size:11.5px; padding:5px 9px;" href="' + esc(t.drive_link || 'https://drive.google.com/file/d/' + esc(t.drive_file_id) + '/view') + '" target="_blank" rel="noopener">Buka</a>'
            : '<a class="btn-sim" style="font-size:11.5px; padding:5px 9px;" href="/api/tugas_download.php?id=' + t.id + '">Unduh</a>') + '</td>' +
