    function collectPt() {
      var updates = [];
      ptTbody.querySelectorAll('tr[data-ptid]').forEach(function (tr) {
        var id = parseInt(tr.getAttribute('data-ptid'), 10);
        updates.push({
          id: id,
          title: tr.querySelector('[data-f="title"]').value,
          subtitle: tr.querySelector('[data-f="subtitle"]').value,
          posisi: parseInt(tr.querySelector('[data-f="posisi"]').value, 10) || 0,
          alokasi: tr.querySelector('[data-f="alokasi"]').value,
          bobot: tr.querySelector('[data-f="bobot"]').value,
          aktif: tr.querySelector('[data-f="aktif"]').checked ? 1 : 0
        });
      });
      return updates;
    }
