    function erdTerapkan(id) {
      var t = erdTemplateById(id);
      if (!t) return;
      if (!confirm('Terapkan template "' + t.title + '" ke worksheet?\nIsian worksheet saat ini akan diganti.')) return;
      var payload = {
        identitas: { nama: '', nim: '', kelas: '', tanggal: '' },
        studiKasus: t.id,
        entitas: t.entitas,
        atribut: t.atribut,
        relasi: t.relasi,
        asumsi: t.asumsi
      };
      try {
        localStorage.setItem('basdat_wks_v1', JSON.stringify(payload));
        document.getElementById('erdMsg').textContent = '✓ Worksheet terisi template "' + t.title + '". Membuka /praktikum…';
        window.open('/praktikum?template=' + encodeURIComponent(t.id), '_self');
      } catch (e) {
        document.getElementById('erdMsg').textContent = 'Gagal menyimpan di browser ini. Coba mode penyamaran/Guest.';
      }
    }

    var erdGridEl = document.getElementById('erdTempGrid');
    if (erdGridEl) {
      renderErdTemplates();
      erdGridEl.addEventListener('click', function (e) {
        var sol = e.target.closest('button[data-sol]');
        if (sol) { erdPreview(erdTemplateById(sol.getAttribute('data-sol'))); return; }
        var ap = e.target.closest('button[data-terapkan]');
        if (ap) erdTerapkan(ap.getAttribute('data-terapkan'));
      });
    }

    var erdResetEl = document.getElementById('erdResetWs');
    if (erdResetEl) {
      erdResetEl.addEventListener('click', function () {
        if (!confirm('Reset isian worksheet /praktikum di browser ini?')) return;
        try { localStorage.removeItem('basdat_wks_v1'); } catch (e) {}
        document.getElementById('erdMsg').textContent = 'Worksheet direset. Membuka /praktikum…';
        window.open('/praktikum', '_self');
      });
    }

    loadAdmin();
    loadPertemuan();
  })();
</script>