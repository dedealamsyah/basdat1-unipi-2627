---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<BaseLayout title="Admin · Dashboard Progres & Nilai · Basis Data UNIPI" description="Panel admin: progres belajar, nilai, dan pengelolaan akun">
  <Sidebar slot="sidebar" />

  <div class="contentHeader">
    <div class="eyebrow">PANEL ADMIN</div>
    <h1 class="pageTitle">Dashboard Progres &amp; Nilai</h1>
    <p class="pageSubtitle">Pantau penyelesaian materi, nilai mahasiswa, impor akun, dan kelola progres per pertemuan.</p>
    <div id="adminStatus" class="muted"></div>
  </div>

  <!-- STATISTIK -->
  <section class="block">
    <h2>Ringkasan</h2>
    <div class="stat-grid" id="statGrid">
      <div class="stat-card"><span class="stat-num" id="stTotal">–</span><span class="stat-label">Mahasiswa</span></div>
      <div class="stat-card"><span class="stat-num" id="stProgres">–</span><span class="stat-label">Rata-rata Progres</span></div>
      <div class="stat-card"><span class="stat-num" id="stNilai">–</span><span class="stat-label">Rata-rata Nilai</span></div>
      <div class="stat-card"><span class="stat-num" id="stTuntas">–</span><span class="stat-label">Tuntas 100%</span></div>
    </div>

    <div style="margin-top:16px;">
      <h3 style="font-family:var(--font-display);color:var(--navy-800);margin:0 0 10px;font-size:15px;">Distribusi Nilai</h3>
      <div id="distBox" class="dist-box">
        <p class="muted">Memuat…</p>
      </div>
    </div>
  </section>

  <!-- FILTER -->
  <section class="block">
    <h2>Pencarian &amp; Filter</h2>
    <div class="filter-row">
      <input type="text" id="qNim" class="wks-input" placeholder="Cari NIM atau nama…" style="flex:2;" />
      <select id="qKelas" class="wks-input" style="flex:1;">
        <option value="">Semua kelas</option>
      </select>
      <button class="btn-sim" id="resetFilter" style="background:#1C3B30;">Reset</button>
    </div>
  </section>

  <!-- IMPORT -->
  <section class="block">
    <h2>Import Akun Mahasiswa</h2>
    <p class="muted" style="margin-bottom:8px;">
      Tempel data per baris dengan format <code>nim,nama,kelas</code>. Contoh:
      <code>26105100,Fulan Bin Fulan,IF3A</code>. Password awal = NIM.
    </p>
    <textarea id="importText" class="wks-input" rows="6" spellcheck="false" placeholder="26105100,Fulan Bin Fulan,IF3A&#10;26105101,Fulanah Binti Fulan,IF3A"></textarea>
    <div style="display:flex; gap:8px; margin-top:10px; flex-wrap:wrap;">
      <button class="btn-sim" id="importBtn" style="background:#2A7A61;">Impor Mahasiswa</button>
      <button class="btn-sim" id="importResetPass" style="background:#1C3B30;">Impor + Reset Password</button>
      <label class="btn-sim" style="background:#4D8B6E; cursor:pointer; display:inline-block;">
        Import dari File CSV <input type="file" id="importCsv" accept=".csv,.txt" hidden />
      </label>
    </div>
    <p class="muted" id="importResult" style="margin-top:10px;"></p>
  </section>

  <!-- DAFTAR -->
  <section class="block">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
      <h2 style="margin:0;">Daftar Mahasiswa <span id="rowCount" class="muted" style="font-size:12px;"></span></h2>
      <button class="btn-sim" id="exportCsv" style="background:#1C3B30;">⬇ Ekspor CSV Nilai</button>
    </div>
    <div style="overflow-x:auto;">
      <table class="dtable" id="adminTable">
        <thead><tr><th>NIM</th><th>Nama</th><th>Kelas</th><th>Tuntas</th><th>%</th><th>Nilai Akhir</th><th>Huruf</th><th>Kelola</th></tr></thead>
        <tbody id="adminTbody"><tr><td colspan="8" class="muted">Memuat…</td></tr></tbody>
      </table>
    </div>
  </section>

  <!-- DETAIL -->
  <section class="block" id="detailBox" hidden>
    <h2 id="detailTitle">Detail Progres</h2>

    <div class="grade-box" id="gradeBox">
      <h3>Nilai Manual &amp; Akhir</h3>
      <div class="grade-grid">
        <label class="grade-item">Kuis (%)<span class="grade-readonly" id="gKuis">–</span></label>
        <label class="grade-item">PTS
          <input type="number" min="0" max="100" id="gPts" class="wks-input" />
        </label>
        <label class="grade-item">UAS
          <input type="number" min="0" max="100" id="gUas" class="wks-input" />
        </label>
        <label class="grade-item">Tugas
          <input type="number" min="0" max="100" id="gTugas" class="wks-input" />
        </label>
        <label class="grade-item">Kehadiran
          <input type="number" min="0" max="100" id="gHadir" class="wks-input" />
        </label>
        <label class="grade-item">Nilai Akhir<span class="grade-readonly" id="gAkhir">–</span></label>
        <label class="grade-item">Huruf<span class="grade-readonly" id="gHuruf">–</span></label>
      </div>
      <p class="muted" style="font-size:11px; margin-top:8px;">
        Rumus: 40% kuis + 30% PTS + 30% UAS. Nilai akhir muncul saat ketiganya terisi.
      </p>
      <div style="display:flex; gap:8px; margin-top:8px; flex-wrap:wrap;">
        <button class="btn-sim" id="gradeSave" style="background:#2A7A61;">Simpan Nilai</button>
        <button class="btn-sim" id="detailClose" style="background:#1C3B30;">Tutup Detail</button>
      </div>
    </div>

    <div style="overflow-x:auto; margin-top:16px;">
      <table class="dtable" id="detailTable">
        <thead><tr><th>Pertemuan</th><th>Status</th><th>Skor Kuis</th><th>Attempts</th><th>Tgl Tuntas</th><th>Kelola</th></tr></thead>
        <tbody id="detailTbody"></tbody>
      </table>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .admin-stat { display: flex; gap: 10px; flex-wrap: wrap; margin: 6px 0 0; }
  .admin-stat .chip { margin: 0; }
  .st-done { color: #1F5F4B; font-weight: 700; }
  .st-locked { color: var(--amber-400); font-weight: 600; }
  td select, td input { padding: 5px 6px; border-radius: 6px; border: 1px solid var(--line); background: var(--card); color: var(--ink); font-size: 12px; }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
  }
  .stat-card {
    background: var(--card);
    box-shadow: var(--neu-shadow-sm);
    border-radius: 12px;
    padding: 16px 14px;
    text-align: center;
  }
  .stat-num {
    display: block;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    color: var(--navy-800);
    margin-bottom: 2px;
  }
  .stat-label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .dist-box { display: flex; flex-direction: column; gap: 6px; }
  .dist-row {
    display: grid;
    grid-template-columns: 42px 1fr 34px;
    align-items: center;
    gap: 8px;
    font-size: 12px;
  }
  .dist-row span:first-child { font-family: var(--font-body); font-weight: 700; color: var(--navy-800); }
  .dist-bar {
    height: 14px;
    border-radius: 7px;
    background: var(--teal-100);
    overflow: hidden;
  }
  .dist-bar i {
    display: block;
    height: 100%;
    border-radius: 7px;
    background: linear-gradient(90deg, #1F5F4B, #2A7A61);
  }
  .dist-row span:last-child { text-align: right; color: var(--ink-soft); }

  .filter-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .filter-row .wks-input { margin-bottom: 0; }

  .grade-box {
    margin-top: 4px;
    padding: 16px;
    border-radius: 12px;
    background: var(--teal-100);
  }
  .grade-box h3 {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--navy-800);
    margin: 0 0 12px;
  }
  .grade-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 10px;
  }
  .grade-item {
    display: flex;
    flex-direction: column;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--navy-700);
    gap: 5px;
  }
  .grade-item .wks-input { margin-bottom: 0; }
  .grade-readonly {
    font-weight: 700;
    font-size: 16px;
    color: var(--navy-800);
    text-transform: none;
    padding: 9px 0;
  }
</style>

<script is:inline>
  (function () {
    var api = function (path, opts) {
      opts = opts || {};
      opts.credentials = 'same-origin';
      opts.cache = 'no-store';
      if (opts.body && typeof opts.body !== 'string') {
        opts.headers = Object.assign({}, opts.headers || {}, { 'Content-Type': 'application/json' });
        opts.body = JSON.stringify(opts.body);
      }
      return fetch(path, opts).then(function (r) { return r.json(); });
    };

    var statusEl = document.getElementById('adminStatus');
    var tbody = document.getElementById('adminTbody');
    var dtbody = document.getElementById('detailTbody');
    var detailBox = document.getElementById('detailBox');
    var totalActive = 0;
    var kelasOptions = [];
    var allStudents = [];

    function fail(msg) {
      statusEl.textContent = '';
      tbody.innerHTML = '<tr><td colspan="8" class="muted">' + msg + '</td></tr>';
    }

    function loadAdmin() {
      statusEl.textContent = 'Memuat data…';
      api('/api/admin.php').then(function (d) {
        if (!d.ok) {
          fail((d.error || 'Akses ditolak.') + ' – hubungi admin atau login sebagai admin.');
          return;
        }
        totalActive = d.data.total;
        statusEl.textContent = 'Total materi aktif: ' + totalActive + ' pertemuan.';
        allStudents = d.data.students;
        kelasOptions = [];
        allStudents.forEach(function (s) { if (s.kelas && kelasOptions.indexOf(s.kelas) === -1) kelasOptions.push(s.kelas); });
        fillKelas();
        renderStats(allStudents);
        renderRows(allStudents);
      }).catch(function () {
        fail('Gagal memuat data. Pastikan API tersedia (/api/admin.php).');
      });
    }

    /* ---- statistik & distribusi ---- */
    function renderStats(sts) {
      var total = sts.length;
      var sumP = 0, sumN = 0, nN = 0, tuntas = 0, dist = {};
      sts.forEach(function (s) {
        sumP += s.persen;
        if (s.akhir != null) { sumN += s.akhir; nN++; }
        if (s.persen >= 100) tuntas++;
        var h = s.huruf || '–';
        dist[h] = (dist[h] || 0) + 1;
      });
      document.getElementById('stTotal').textContent = total;
      document.getElementById('stProgres').textContent = total ? Math.round(sumP / total) + '%' : '–';
      document.getElementById('stNilai').textContent = nN ? Math.round(sumN / nN) : '–';
      document.getElementById('stTuntas').textContent = tuntas;

      var order = ['A', 'AB', 'B', 'BC', 'C', 'D', 'E'];
      var box = document.getElementById('distBox');
      var max = 1;
      order.forEach(function (h) { if ((dist[h] || 0) > max) max = dist[h]; });
      box.innerHTML = '';
      order.forEach(function (h) {
        var c = dist[h] || 0;
        var row = document.createElement('div');
        row.className = 'dist-row';
        row.innerHTML = '<span>' + h + '</span><div class="dist-bar"><i style="width:' + (c / max * 100) + '%"></i></div><span>' + c + '</span>';
        box.appendChild(row);
      });
    }

    /* ---- filter ---- */
    function fillKelas() {
      var sel = document.getElementById('qKelas');
      sel.innerHTML = '<option value="">Semua kelas</option>';
      kelasOptions.sort().forEach(function (k) {
        var o = document.createElement('option');
        o.value = k;
        o.textContent = k;
        sel.appendChild(o);
      });
    }
    function applyFilter() {
      var q = (document.getElementById('qNim').value || '').toLowerCase().trim();
      var kl = document.getElementById('qKelas').value;
      var rows = allStudents.filter(function (s) {
        if (kl && s.kelas !== kl) return false;
        if (q && (s.nim.toLowerCase().indexOf(q) === -1) && (s.nama.toLowerCase().indexOf(q) === -1)) return false;
        return true;
      });
      document.getElementById('rowCount').textContent = '(' + rows.length + ' dari ' + allStudents.length + ')';
      renderRows(rows);
    }

    function renderRows(students) {
      window.__students = students;
      if (!students.length) {
        tbody.innerHTML = '<tr><td colspan="8" class="muted">Tidak ada data sesuai filter. Impor data terlebih dahulu.</td></tr>';
        return;
      }
      tbody.innerHTML = '';
      students.forEach(function (s) {
        var tr = document.createElement('tr');
        tr.innerHTML =
          '<td>' + esc(s.nim) + '</td>' +
          '<td>' + esc(s.nama) + '</td>' +
          '<td>' + esc(s.kelas) + '</td>' +
          '<td>' + s.done_count + ' / ' + s.total + '</td>' +
          '<td>' + s.persen + '%</td>' +
          '<td>' + (s.akhir != null ? s.akhir : '–') + '</td>' +
          '<td>' + (s.huruf ? '<strong>' + esc(s.huruf) + '</strong>' : '–') + '</td>' +
          '<td><button class="btn-sim" data-view="' + esc(s.nim) + '" style="background:#1C3B30;">Lihat</button> ' +
          '<button class="btn-sim" data-del="' + esc(s.nim) + '" style="background:#C9584F;">Hapus</button></td>';
        tbody.appendChild(tr);
      });
    }

    function esc(s) {
      return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function loadDetail(nim) {
      detailBox.hidden = false;
      detailBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
      document.getElementById('detailTitle').textContent = 'Memuat detail ' + nim + '…';
      api('/api/admin.php?nim=' + encodeURIComponent(nim)).then(function (d) {
        if (!d.ok) { alert(d.error || 'Gagal memuat detail.'); detailBox.hidden = true; return; }
        document.getElementById('detailTitle').textContent = 'Detail Progres: ' + nim;
        window.__curNim = nim;

        var n = d.data.nilai || {};
        document.getElementById('gKuis').textContent = n.kuis_pct != null ? n.kuis_pct + '%' : '–';
        document.getElementById('gPts').value = n.pts != null ? n.pts : '';
        document.getElementById('gUas').value = n.uas != null ? n.uas : '';
        document.getElementById('gTugas').value = n.tugas != null ? n.tugas : '';
        document.getElementById('gHadir').value = n.hadir != null ? n.hadir : '';
        document.getElementById('gAkhir').textContent = n.akhir != null ? n.akhir : '–';
        document.getElementById('gHuruf').textContent = n.huruf || '–';

        dtbody.innerHTML = '';
        d.data.progress.forEach(function (p) {
          var st = p.status;
          var stText = st === 'done' ? '<span class="st-done">✓ Tuntas</span>' : (st === 'open' ? 'Terbuka' : '<span class="st-locked">Terkunci</span>');
          var tr = document.createElement('tr');
          tr.innerHTML =
            '<td>Pertemuan ' + p.pertemuan_id + '</td>' +
            '<td>' + stText + '</td>' +
            '<td>' + p.quiz_score + (p.quiz_total ? ' / ' + p.quiz_total : '') + '</td>' +
            '<td>' + p.attempts + '</td>' +
            '<td>' + (p.completed_at ? p.completed_at.slice(0, 10) : '–') + '</td>' +
            '<td><button class="btn-sim" data-toggle="' + p.pertemuan_id + '" style="background:' + (st === 'done' ? '#C9584F;' : '#2A7A61;') + '" data-nim="' + esc(nim) + '">' + (st === 'done' ? 'Batal' : 'Tandai Tuntas') + '</button></td>';
          dtbody.appendChild(tr);
        });
      }).catch(function () {
        alert('Gagal menghubungi API detail.');
        detailBox.hidden = true;
      });
    }

    /* ---- klik tabel utama ---- */
    tbody.addEventListener('click', function (e) {
      var btn = e.target.closest('button[data-view]');
      if (btn) { loadDetail(btn.getAttribute('data-view')); return; }
      var del = e.target.closest('button[data-del]');
      if (del) {
        var nim = del.getAttribute('data-del');
        if (!confirm('Hapus akun mahasiswa ' + nim + ' beserta progresnya?')) return;
        api('/api/delete_user.php', { method: 'POST', body: { nim: nim } }).then(function (d) {
          if (!d.ok) { alert(d.error || 'Gagal.'); return; }
          detailBox.hidden = true;
          loadAdmin();
        });
      }
    });

    /* ---- klik baris detail pertemuan ---- */
    dtbody.addEventListener('click', function (e) {
      var btn = e.target.closest('button[data-toggle]');
      if (!btn) return;
      var nim = btn.getAttribute('data-nim');
      var pid = parseInt(btn.getAttribute('data-toggle'), 10);
      var action = btn.textContent.indexOf('Batal') === 0 ? 'undone' : 'done';
      if (action === 'undone' && !confirm('Batal tuntas pertemuan ini untuk ' + nim + '?')) return;
      api('/api/unlock.php', { method: 'POST', body: { nim: nim, pertemuan_id: pid, action: action } }).then(function (d) {
        if (!d.ok) { alert(d.error || 'Gagal.'); return; }
        loadDetail(nim);
        loadAdmin();
      });
    });

    /* ---- tutup detail ---- */
    document.getElementById('detailClose').addEventListener('click', function () { detailBox.hidden = true; });

    /* ---- simpan nilai manual ---- */
    document.getElementById('gradeSave').addEventListener('click', function () {
      var nim = window.__curNim;
      if (!nim) return;
      var comps = [{ k: 'pts', el: gEl('gPts') }, { k: 'uas', el: gEl('gUas') },
                   { k: 'tugas', el: gEl('gTugas') }, { k: 'hadir', el: gEl('gHadir') }];
      var btn = document.getElementById('gradeSave');
      btn.disabled = true;
      btn.textContent = 'Menyimpan…';
      var chain = Promise.resolve();
      comps.forEach(function (c) {
        chain = chain.then(function () {
          var v = c.el.value.trim();
          var nilai = v === '' ? -1 : parseInt(v, 10);
          return api('/api/grade.php', { method: 'POST', body: { nim: nim, komponen: c.k, nilai: isNaN(nilai) ? -1 : nilai } });
        });
      });
      chain.then(function (res) {
        btn.disabled = false;
        btn.textContent = 'Simpan Nilai';
        if (res && res.ok) {
          loadDetail(nim);
          loadAdmin();
        } else {
          alert((res && res.error) || 'Gagal menyimpan.');
        }
      });
    });
    function gEl(id) { return document.getElementById(id); }

    /* ---- ekspor CSV ---- */
    document.getElementById('exportCsv').addEventListener('click', function () {
      var sts = window.__students || allStudents;
      if (!sts.length) { alert('Belum ada data untuk diekspor.'); return; }
      var rows = [['NIM', 'Nama', 'Kelas', 'Tuntas', 'Total', 'Persen', 'NilaiAkhir', 'Huruf']];
      sts.forEach(function (s) {
        rows.push([s.nim, s.nama, s.kelas, s.done_count, s.total, s.persen + '%', s.akhir == null ? '' : s.akhir, s.huruf || '']);
      });
      var csv = rows.map(function (r) {
        return r.map(function (c) {
          var s = String(c);
          return (s.indexOf(',') !== -1 || s.indexOf('"') !== -1) ? '"' + s.replace(/"/g, '""') + '"' : s;
        }).join(',');
      }).join('\r\n');
      var blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'nilai-' + new Date().toISOString().slice(0, 10) + '.csv';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(a.href);
    });

    /* ---- import ---- */
    function doImport() {
      var text = document.getElementById('importText').value.trim();
      if (!text) { document.getElementById('importResult').textContent = 'Isi kolom data dulu.'; return; }
      document.getElementById('importResult').textContent = 'Mengimpor…';
      api('/api/import_users.php', { method: 'POST', body: text, headers: { 'Content-Type': 'text/plain' } }).then(function (d) {
        if (!d.ok) {
          document.getElementById('importResult').textContent = 'Gagal: ' + (d.error || '?');
          return;
        }
        document.getElementById('importResult').textContent =
          'Selesai: ' + d.data.imported + ' baru, ' + d.data.updated_existing + ' diperbarui. Password awal = NIM.';
        document.getElementById('importText').value = '';
        loadAdmin();
      });
    }

    document.getElementById('importBtn').addEventListener('click', function () { doImport(); });
    document.getElementById('importResetPass').addEventListener('click', function () {
      var text = document.getElementById('importText').value.trim();
      if (!text) {
        document.getElementById('importResult').textContent = 'Tempel data mahasiswa (nim,nama,kelas) lalu klik impor + reset.';
        return;
      }
      document.getElementById('importResult').textContent = 'Mengimpor + reset password…';
      api('/api/import_users.php?reset=1', { method: 'POST', body: text, headers: { 'Content-Type': 'text/plain' } }).then(function (d) {
        document.getElementById('importResult').textContent = d.ok
          ? 'Selesai: ' + d.data.imported + ' baru, ' + d.data.updated_existing + ' direset password ke NIM.'
          : 'Gagal: ' + (d.error || '?');
        document.getElementById('importText').value = '';
        loadAdmin();
      });
    });

    document.getElementById('importCsv').addEventListener('change', function (e) {
      var f = e.target.files && e.target.files[0];
      if (!f) return;
      var r = new FileReader();
      r.onload = function () {
        document.getElementById('importText').value = r.result;
        document.getElementById('importResult').textContent = 'File dibaca: klik "Impor Mahasiswa".';
      };
      r.readAsText(f);
      e.target.value = '';
    });

    /* ---- filter events ---- */
    document.getElementById('qNim').addEventListener('input', applyFilter);
    document.getElementById('qKelas').addEventListener('change', applyFilter);
    document.getElementById('resetFilter').addEventListener('click', function () {
      document.getElementById('qNim').value = '';
      document.getElementById('qKelas').value = '';
      applyFilter();
    });

    loadAdmin();
  })();
</script>