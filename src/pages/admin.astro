    function loadPertemuan() {
      ptTbody.innerHTML = '<tr><td colspan="7" class="muted">Memuat…</td></tr>';
      api('/api/pertemuan.php').then(function (d) {
        if (!d.ok) { ptTbody.innerHTML = '<tr><td colspan="7" class="muted">Gagal memuat.</td></tr>'; return; }
        ptRows = d.data.pertemuan; renderPt(); renderMengajar();
      });
