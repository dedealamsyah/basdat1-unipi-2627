    function renderMengajar() {
      var tbody = document.getElementById('mengajarTbody');
      if (!tbody) return;
      if (!ptRows.length) {
        tbody.innerHTML = '<tr><td colspan="5" class="muted">Belum ada data pertemuan.</td></tr>';
        return;
      }
      var countEl = document.getElementById('mengajarCount');
      if (countEl) {
        var nAktif = ptRows.filter(function (p) { return !!p.aktif; }).length;
        countEl.textContent = 'Daftar ' + ptRows.length + ' pertemuan · ' + nAktif + ' aktif';
      }
      var rows = ptRows.slice().sort(function (a, b) {
        return ((a.posisi || 99) - (b.posisi || 99)) || (a.id - b.id);
      });
      tbody.innerHTML = '';
      rows.forEach(function (p) {
        var badge = p.aktif
          ? '<span class="chip chip--sm" style="background:var(--green-600); color:#fff;">AKTIF</span>'
          : '<span class="chip chip--sm" style="background:var(--ink-faint); color:#fff;">SEMBUNYI</span>';
        var info = [];
        if (p.alokasi) info.push('⏱ ' + esc(p.alokasi));
        if (p.bobot) info.push('BOBOT ' + esc(p.bobot));
        if (p.cpmk) info.push(esc(p.cpmk));
        var tr = document.createElement('tr');
        tr.innerHTML =
          '<td class="mengajar__pid">P' + String(p.id).padStart(2, '0') + '</td>' +
          '<td><div class="mengajar__t">' + esc(p.title || 'Belum berjudul') + '</div>' +
          (p.subtitle ? '<div class="mengajar__s">' + esc(p.subtitle) + '</div>' : '') + '</td>' +
          '<td class="mengajar__info">' + (info.length ? info.join(' · ') : '–') + '</td>' +
          '<td>' + badge + '</td>' +
          '<td class="mengajar__btn">' +
          '<a class="btn-sim" style="background:var(--navy-700); color:#fff;" href="/presentasi.php?p=' + p.id + '">▶ Presentasikan</a>' +
          '<a class="btn-sim" style="background:var(--green-600); color:#fff;" href="/pertemuan/' + p.id + '">Buka Materi</a>' +
          '</td>';
        tbody.appendChild(tr);
      });
