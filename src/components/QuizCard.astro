---
interface Props {
  question: string;
  id?: string;
}

const { question, id } = Astro.props;
const quizId = id || `quiz-${String(Math.floor(Math.random() * 100000))}`;
---

<div class="interactive-card" data-quiz={quizId}>
  <p><strong>{question}</strong></p>
  <slot />
  <div class="quiz-feedback" style="margin-top:10px; font-weight:600;"></div>
</div>

<script is:inline define:vars={{ quizId }}>
  (function() {
    var card = document.querySelector('[data-quiz="' + quizId + '"]');
    if (!card) return;

    // Pelacak tuntas per pertemuan: hanya lapor bila SEMUA kuis benar
    if (!window.__quizTracker) {
      window.__quizTracker = {
        report: function(qid, pid) {
          if (!pid) return;
          var st = window.__quizState = window.__quizState || {};
          var key = String(pid);
          st[key] = st[key] || { done: {}, reported: false };
          st[key].done[qid] = true;
          var total = document.querySelectorAll('.interactive-card[data-quiz]').length;
          var done = Object.keys(st[key].done).length;
          if (total > 0 && done >= total && !st[key].reported) {
            st[key].reported = true;
            if (typeof window.APIAuth !== 'undefined') {
              window.APIAuth.complete(pid, done, total).then(function(res) {
                if (res && res.progress && window.APIAuth.refresh) window.APIAuth.refresh();
              });
            }
          }
        },
        reset: function() { window.__quizState = {}; }
      };
    }

    card.querySelectorAll('.quiz-option').forEach(function(btn) {
      btn.onclick = function() {
        var isCorrect = this.getAttribute('data-correct') === 'true';
        var feedback = card.querySelector('.quiz-feedback');

        card.querySelectorAll('.quiz-option').forEach(function(opt) {
          opt.classList.remove('correct', 'wrong');
        });

        feedback.textContent = '';
        if (isCorrect) {
          this.classList.add('correct');
          var explanation = this.getAttribute('data-explanation') || '';
          var span = document.createElement('span');
          span.style.color = 'var(--green-600)';
          span.textContent = '[Benar] ' + explanation;
          feedback.appendChild(span);
          var meta = document.getElementById('pageMeta');
          if (meta) {
            var pid = parseInt(meta.getAttribute('data-pertemuan'), 10);
            window.__quizTracker.report(quizId, pid);
          }
        } else {
          this.classList.add('wrong');
          var span2 = document.createElement('span');
          span2.style.color = 'var(--red-600)';
          span2.textContent = '[Kurang tepat] Coba perhatikan kembali konsepnya.';
          feedback.appendChild(span2);
        }
      };
    });

    // Reset tracker saat navigasi dalam situs (pergantian halaman)
    document.addEventListener('astro:before-swap', function() {
      if (window.__quizTracker) window.__quizTracker.reset();
    });
  })();
</script>
