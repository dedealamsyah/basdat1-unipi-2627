---
interface Props {
  question: string;
  id?: string;
}

const { question, id } = Astro.props;
const quizId = id || `quiz-${String(Math.floor(Math.random() * 100000))}`;
---

<div class="interactive-card" data-quiz={quizId}>
  <p><strong>{question}</strong></p>
  <slot />
  <div class="quiz-feedback" style="margin-top:10px; font-weight:600;"></div>
</div>

<script is:inline define:vars={{ quizId }}>
  (function() {
    var card = document.querySelector('[data-quiz="' + quizId + '"]');
    if (!card) return;
    
    card.querySelectorAll('.quiz-option').forEach(function(btn) {
      btn.onclick = function() {
        var isCorrect = this.getAttribute('data-correct') === 'true';
        var feedback = card.querySelector('.quiz-feedback');
        
        card.querySelectorAll('.quiz-option').forEach(function(opt) {
          opt.classList.remove('correct', 'wrong');
        });

        feedback.textContent = '';
        if (isCorrect) {
          this.classList.add('correct');
          var explanation = this.getAttribute('data-explanation') || '';
          var span = document.createElement('span');
          span.style.color = '#166534';
          span.textContent = '[Benar] ' + explanation;
          feedback.appendChild(span);
        } else {
          this.classList.add('wrong');
          var span2 = document.createElement('span');
          span2.style.color = '#991b1b';
          span2.textContent = '[Kurang tepat] Coba perhatikan kembali konsepnya.';
          feedback.appendChild(span2);
        }
      };
    });
  })();
</script>
