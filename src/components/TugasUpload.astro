---
interface Props {
  pid: number;
  title: string;
  note?: string;
}
const { pid, title, note } = Astro.props;
---

<section class="tugas-box" data-tugasbox={pid}>
  <div class="tugas-box__head">
    <span class="tugas-box__badge">PENGUMPULAN TUGAS · LINK DRIVE</span>
    <h3 class="tugas-box__title">{title}</h3>
  </div>
  {note && <p class="tugas-box__note">{note}</p>}
  <ol class="tugas-box__steps">
    <li>Unggah berkas tugas ke <strong>Google Drive</strong> pribadi Anda.</li>
    <li>Buka berkas → <strong>Bagikan</strong> → ubah akses menjadi <strong>"Siapa saja yang memiliki link"</strong> (Viewer). Jangan memakai mode privat.</li>
    <li>Salin tautan berbagi, lalu tempel di kolom di bawah ini.</li>
  </ol>
  <div class="tugas-box__state">Memeriksa status…</div>
  <form class="tugas-box__form" hidden>
    <div class="tugas-box__field">
      <label class="tugas-box__label" for="tg-{pid}">Tautan Google Drive berkas tugas</label>
      <input class="tugas-box__input" id="tg-{pid}" type="url" inputmode="url"
             placeholder="https://drive.google.com/file/d/…/view?usp=sharing"
             autocomplete="off" spellcheck="false" />
    </div>
    <button type="submit" class="btn-sim" style="background:var(--teal-400);">Simpan Tautan</button>
    <p class="tugas-box__hint">Pastikan berbagi diatur ke <strong>publik (siapa saja yang memiliki link)</strong>. Satu pengumpulan per mahasiswa, boleh diganti sebelum batas waktu.</p>
  </form>
</section>

<style>
  .tugas-box {
    margin: 22px 0;
    border: 1.5px solid var(--teal-500);
    border-radius: 16px;
    background: var(--card);
    padding: 18px 20px;
    box-shadow: var(--shadow-sm);
  }
  .tugas-box__head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding-bottom: 8px; }
  .tugas-box__badge {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: .1em; font-weight: 700;
    color: #fff; background: var(--teal-500); border-radius: 14px; padding: 4px 12px;
  }
  .tugas-box__title { margin: 0; font-family: var(--font-display); font-size: 17px; color: var(--ink); }
  .tugas-box__note { font-size: 13.5px; color: var(--ink-soft); line-height: 1.7; margin: 6px 0; }
  .tugas-box__steps { margin: 8px 0 10px; padding-left: 20px; font-size: 13px; color: var(--ink-soft); line-height: 1.8; }
  .tugas-box__steps li { margin: 2px 0; }
  .tugas-box__state { font-size: 13px; color: var(--ink); line-height: 1.6; margin-top: 6px; }
  .tugas-box__state .ok { color: var(--green-600); font-weight: 700; }
  .tugas-box__state a { color: var(--teal-600); }
  .tugas-box__form { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 12px; margin-top: 12px; }
  .tugas-box__field { display: flex; flex-direction: column; gap: 4px; flex: 1 1 320px; }
  .tugas-box__label { font-size: 12px; font-weight: 700; color: var(--ink); }
  .tugas-box__input {
    font-family: var(--font-mono); font-size: 12.5px; padding: 9px 11px;
    border: 1.5px solid var(--line, #d2c7ae); border-radius: 10px;
    background: var(--bg-soft, #fff); color: var(--ink);
  }
  .tugas-box__input:focus { outline: none; border-color: var(--teal-500); }
  .tugas-box__hint { width: 100%; margin: 0; font-size: 11.5px; color: var(--ink-faint); }
</style>

<script is:inline>
  (function () {
    function initTugas(pid) {
      var box = document.querySelector('.tugas-box[data-tugasbox="' + pid + '"]');
      if (!box) return;
      var stateEl = box.querySelector('.tugas-box__state');
      var form = box.querySelector('.tugas-box__form');
      var linkInput = box.querySelector('.tugas-box__input');

      function setState(html, cls) {
        stateEl.className = 'tugas-box__state' + (cls ? ' ' + cls : '');
        stateEl.innerHTML = html;
      }
      function esc(s) {
        return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }
      function looksLikeDrive(url) {
        return /^(https?:\/\/)?[\w.-]*\.?google\.com\//.test(url) &&
          (/drive\.google\.com/.test(url) || /docs\.google\.com/.test(url));
      }

      // Bind submit SEGERA (mencegah submit native/reload), tidak bergantung
      // pada apakah modul APIAuth sudah termuat atau belum.
      if (!box.dataset.bound) {
        box.dataset.bound = '1';
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var link = (linkInput.value || '').trim();
          if (!link) { setState('Tempel tautan Google Drive terlebih dahulu.'); return; }
          if (!looksLikeDrive(link)) {
            setState('Tautan harus berasal dari <strong>drive.google.com</strong> atau <strong>docs.google.com</strong>.');
            return;
          }
          setState('Memeriksa tautan… silakan tunggu.');
          (function waitApi() {
            if (typeof window.APIAuth === 'undefined') { setTimeout(waitApi, 120); return; }
            window.APIAuth.me(true).then(function () {
              return window.APIAuth.api('/api/upload_tugas.php', {
                method: 'POST',
                body: { pertemuan_id: String(pid), drive_link: link }
              });
            }).then(function (r) {
              var d = r.data || {};
              if (d.ok && d.data) {
                setState('<span class="ok">Tautan tersimpan.</span> ' +
                  '<a href="' + esc(d.data.drive_link) + '" target="_blank" rel="noopener">Buka berkas Anda</a> · ' +
                  esc(d.data.submitted_at || ''));
                loadStatus();
              } else {
                setState('Gagal: ' + esc(d.error || 'Terjadi kesalahan.'));
              }
            }).catch(function () {
              setState('Gagal terhubung ke server. Periksa koneksi lalu coba lagi.');
            });
          })();
        });
      }

      // Status & aksi yang butuh APIAuth: polling hingga siap
      if (!box.dataset.boot) {
        box.dataset.boot = '1';
        (function waitAuth() {
          if (typeof window.APIAuth !== 'undefined') { onAuthReady(); return; }
          if (!box.__poll) box.__poll = 0;
          if (++box.__poll <= 100) { setTimeout(waitAuth, 150); return; }
          setState('Modul akses tidak termuat. Muat ulang halaman.');
        })();
      }

      function loadStatus() {
        setState('Memeriksa…');
        window.APIAuth.api('/api/upload_tugas.php?pertemuan_id=' + pid).then(function (r) {
          var d = r.data && r.data.data;
          if (d && d.drive_link) {
            form.hidden = false;
            linkInput.value = d.drive_link;
            setState(
              '<span class="ok">Sudah terkumpul.</span> ' +
              '<a href="' + esc(d.drive_link) + '" target="_blank" rel="noopener">Buka berkas tugas Anda</a> · ' +
              esc(d.submitted_at) + '. Anda boleh menggantinya di bawah.'
            );
          } else {
            form.hidden = false;
            setState('Belum ada pengumpulan. Selesaikan 3 langkah di atas lalu tempel tautan Anda.');
          }
        }).catch(function () {
          setState('Server tidak merespons. Coba lagi nanti.');
        });
      }

      function onAuthReady() {
        window.APIAuth.me(true).then(function (p) {
          if (!p.logged_in) {
            setState('Silakan <a href="/login?next=' + encodeURIComponent(location.pathname) + '">login</a> untuk mengumpulkan tugas.');
            return;
          }
          loadStatus();
        }).catch(function () {
          setState('Gagal memeriksa status. Muat ulang halaman.');
        });
      }
    }

    document.querySelectorAll('.tugas-box').forEach(function (b) {
      var pid = b.getAttribute('data-tugasbox');
      if (pid) initTugas(parseInt(pid, 10));
    });
    document.addEventListener('astro:page-load', function () {
      document.querySelectorAll('.tugas-box').forEach(function (b) {
        var pid = b.getAttribute('data-tugasbox');
        if (pid) initTugas(parseInt(pid, 10));
      });
    });
  })();
</script>