---
interface EvaluasiSoal {
  soal: string;
  opsi: string[];
  benar: number;
}

interface Props {
  pid: number;
  data: EvaluasiSoal[];
}

const { pid, data } = Astro.props;
---

<section class="evaluasi" id="evaluasiBox" data-pid={pid}>
  <div class="evaluasi__head">
    <span class="evaluasi__badge">EVALUASI PERTEMUAN {pid}</span>
    <p>
      Jawab <strong>semua soal</strong> dengan pemahaman Anda sendiri. Hasil hanya
      ditampilkan sebagai skor, tanpa kunci jawaban, dan <strong>hanya 1x percobaan</strong>.
    </p>
  </div>
  <div class="evaluasi__state" id="evaluasiState"><p class="muted">Memeriksa akses evaluasi…</p></div>
  <div class="evaluasi__form" id="evaluasiForm" hidden></div>
</section>

<style is:global>
  .evaluasi {
    margin: 28px 0;
    padding: 20px;
    border-radius: var(--radius-lg);
    border: 1.5px solid var(--amber-300);
    background: linear-gradient(180deg, var(--card), var(--paper));
    box-shadow: var(--shadow-md);
  }
  [data-theme="dark"] .evaluasi { background: linear-gradient(180deg, var(--card), #0b1311); }
  .evaluasi__head { margin-bottom: 14px; }
  .evaluasi__head p { margin: 8px 0 0; font-size: 13px; color: var(--ink-soft); line-height: 1.6; }
  .evaluasi__badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    color: var(--amber-400);
    background: var(--amber-50);
    border: 1px solid var(--amber-200);
    border-radius: 20px;
    padding: 4px 12px;
  }
  [data-theme="dark"] .evaluasi__badge { background: rgba(231, 168, 61, .12); border-color: rgba(231, 168, 61, .35); }

  .eq-block {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 14px 16px;
    margin-bottom: 12px;
  }
  .eq-block__q { font-weight: 700; font-size: 14.5px; color: var(--ink); margin: 0 0 10px; }
  .eq-block__opts { display: grid; gap: 8px; }
  .eq-opt {
    display: flex; align-items: flex-start; gap: 10px;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 12px;
    cursor: pointer;
    background: var(--paper);
    transition: border-color .15s, background .15s, box-shadow .15s;
  }
  [data-theme="dark"] .eq-opt { background: #0f1816; }
  .eq-opt:hover { border-color: var(--teal-400); }
  .eq-opt.sel { border-color: var(--navy-700); background: var(--teal-100); box-shadow: var(--shadow-sm); }
  [data-theme="dark"] .eq-opt.sel { background: rgba(43, 166, 160, .16); }
  .eq-opt input { margin-top: 3px; accent-color: var(--navy-700); }
  .eq-opt__label { font-size: 13.5px; color: var(--ink); line-height: 1.5; }

  .eq-opt.is-locked, .eq-opt.is-locked:hover { cursor: default; border-color: var(--line); }
  .eq-opt.is-locked input { accent-color: var(--ink-soft); }

  .ev-track { margin-bottom: 14px; }
  .ev-track__label {
    display: flex; justify-content: space-between;
    font-size: 11px; font-weight: 700; letter-spacing: .06em;
    color: var(--ink-soft); text-transform: uppercase;
  }
  .ev-track__bar { height: 8px; border-radius: 6px; background: var(--teal-100); margin-top: 6px; overflow: hidden; }
  [data-theme="dark"] .ev-track__bar { background: rgba(43, 166, 160, .15); }
  .ev-track__bar i {
    display: block; height: 100%; border-radius: 6px;
    background: linear-gradient(90deg, var(--navy-700), var(--teal-400));
    transition: width .25s ease;
  }
  .ev-card {
    background: var(--card); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 18px 18px 16px; box-shadow: var(--shadow-sm);
  }
  .ev-card__no { font-family: var(--font-mono); font-size: 11px; font-weight: 700; color: var(--amber-500); letter-spacing: .05em; margin-bottom: 6px; }
  .ev-card__q { font-weight: 700; font-size: 15px; color: var(--ink); margin: 0 0 12px; line-height: 1.5; }
  .ev-opts { display: grid; gap: 8px; }
  .ev-opt {
    display: flex; align-items: flex-start; gap: 10px;
    border: 1px solid var(--line); border-radius: 10px; padding: 11px 12px;
    cursor: pointer; background: var(--paper);
    transition: border-color .15s, background .15s, box-shadow .15s;
  }
  [data-theme="dark"] .ev-opt { background: #0f1816; }
  .ev-opt:hover { border-color: var(--teal-400); }
  .ev-opt input { margin-top: 3px; accent-color: var(--navy-700); }
  .ev-opt__label { font-size: 13.5px; color: var(--ink); line-height: 1.5; }
  .ev-opt.sel { border-color: var(--navy-700); background: var(--teal-100); box-shadow: var(--shadow-sm); }
  [data-theme="dark"] .ev-opt.sel { background: rgba(43, 166, 160, .16); }
  .ev-nav { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 14px; flex-wrap: wrap; }
  .ev-nav span { font-size: 12.5px; color: var(--ink-soft); }
  .ev-nav__right { display: flex; gap: 8px; }

  .ev-intro h3 { font-family: var(--font-display); font-size: 18px; color: var(--navy-800); margin: 0 0 10px; }
  .ev-intro p { font-size: 13.5px; color: var(--ink-soft); line-height: 1.7; margin: 0 0 12px; }
  .ev-intro ul { margin: 0 0 16px; padding-left: 20px; }
  .ev-intro li { font-size: 13px; color: var(--ink); line-height: 1.7; margin-bottom: 4px; }
  .ev-intro .btn-sim { margin-top: 4px; }

  .evaluasi__actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-top: 14px; }
  .evaluasi__msg { margin-top: 12px; font-size: 13px; line-height: 1.6; }

  .ev-keep {
    position: fixed; left: 50%; bottom: 84px; transform: translateX(-50%);
    z-index: 4000; max-width: min(480px, 92vw);
    background: #221A02; color: #ffefc2;
    border: 1px solid var(--amber-300); border-radius: 12px;
    padding: 12px 16px; font-size: 13px; line-height: 1.5; text-align: center;
    box-shadow: var(--shadow-lg);
    pointer-events: none;
  }
  .ev-keep b { color: #ffd97a; }

  .evaluasi__result {
    background: var(--green-50); border: 1.5px solid var(--green-400);
    border-radius: var(--radius); padding: 18px; text-align: center;
  }
  [data-theme="dark"] .evaluasi__result { background: rgba(34, 160, 100, .12); }
  .evaluasi__result .big { font-family: var(--font-display); font-size: 34px; font-weight: 700; color: var(--green-700); }
  [data-theme="dark"] .evaluasi__result .big { color: var(--green-400); }
  .evaluasi__result .sub { color: var(--ink-soft); font-size: 12.5px; margin-top: 6px; }
  .evaluasi__warn {
    margin-top: 10px; background: #FBEFDC; border: 1px solid #E7A83D;
    border-radius: 10px; padding: 10px 12px; font-size: 12.5px; color: #7a5510; line-height: 1.5;
  }
  .evaluasi__locked {
    background: var(--navy-50); border: 1.5px dashed var(--navy-600);
    border-radius: var(--radius); padding: 16px; text-align: center; font-size: 13.5px;
  }
  [data-theme="dark"] .evaluasi__locked { background: rgba(19, 36, 31, .5); }
  .evaluasi__locked b { color: var(--navy-800); }
</style>

<script is:inline define:vars={{ pid, data }}>
  (function () {
    var box = document.getElementById('evaluasiBox');
    if (!box) return;

    var stateEl = document.getElementById('evaluasiState');
    var formEl = document.getElementById('evaluasiForm');
    var pertemuanId = pid;
    var questions = data || [];

    if (!questions.length) { stateEl.textContent = ''; return; }

    // urutan acak opsi per soal (ditentukan saat halaman dimuat)
    var order = questions.map(function (q) {
      var idx = q.opsi.map(function (_, i) { return i; });
      for (var i = idx.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = idx[i]; idx[i] = idx[j]; idx[j] = t;
      }
      return idx;
    });

    var sel = {};          // qi -> original option index
    var backupKey = 'eval_draft_p' + pertemuanId;
    var startedAt = Date.now();
    var pasteCount = 0, copyCount = 0, blurCount = 0;
    var submitted = false;
    var submitting = false;
    var isActive = false;
    var current = 0;       // indeks soal yang sedang ditampilkan
    var stage = 'intro';   // 'intro' | 'quiz'
    var preview = false;   // mode admin: pratinjau tanpa penyimpanan

    function api(path, opts) {
      if (typeof window.APIAuth !== 'undefined' && window.APIAuth.api) {
        return window.APIAuth.api(path, opts).then(function (r) { return r && r.data ? r.data : {}; });
      }
      var o = opts || {};
      o.credentials = 'same-origin';
      if (o.body && typeof o.body !== 'string') o.body = JSON.stringify(o.body);
      return fetch(path, o).then(function (r) { return r.json(); });
    }

    function me() {
      return api('/api/me.php').then(function (d) {
        return d.data || {};
      });
    }

    function esc(s) {
      return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function setState(html) {
      stateEl.innerHTML = html;
      formEl.hidden = true;
    }

    function renderForm(saved) {
      isActive = true;
      stateEl.innerHTML = '';
      formEl.hidden = false;
      if (saved && saved.sel) sel = saved.sel;
      if (saved && saved.current != null) current = saved.current;
      if (sel && Object.keys(sel).length) stage = 'quiz'; else stage = 'intro';
      if (current < 0 || current >= questions.length) current = 0;
      draw();
      armAntiCheat();
    }

    function savePos() {
      try { localStorage.setItem(backupKey, JSON.stringify({ sel: sel, current: current, stage: stage })); } catch (e) {}
    }

    function draw() {
      formEl.innerHTML =
        '<div class="ev-track">' +
        '<span class="ev-track__label"><span id="evProg"></span><span id="evProgCnt"></span></span>' +
        '<div class="ev-track__bar"><i id="evBar"></i></div></div>' +
        '<div class="ev-card" id="evCard"></div>' +
        '<div class="ev-nav" id="evNav"></div>' +
        '<div class="evaluasi__msg" id="evalMsg"></div>';
      if (stage === 'intro') drawIntro(); else drawQuestion();
      updateTrack();
      bindCard();
    }

    function drawIntro() {
      var card = document.getElementById('evCard');
      card.innerHTML =
        '<div class="ev-intro">' +
        '<h3>Selamat datang, evaluasi siap dimulai</h3>' +
        '<p>Evaluasi ini mengukur pemahaman Anda terhadap materi <strong>Pertemuan ' + pertemuanId + '</strong> setelah menyelesaikan latihan. Bacalah petunjuk berikut sebelum memulai.</p>' +
        '<ul>' +
        '<li>Total <strong>' + questions.length + ' soal</strong> pilihan ganda, dikerjakan satu per satu dalam kartu.</li>' +
        '<li>Hanya <strong>1x percobaan</strong>. Begitu dikumpulkan, tidak bisa dikerjakan ulang.</li>' +
        '<li>Jawaban benar/salah <strong>tidak ditampilkan</strong>; Anda hanya melihat skor akhir.</li>' +
        '<li>Aktivitas salin/tempel (copy-paste) <strong>diblokir dan dicatat</strong>.</li>' +
        '<li>Berpindah tab/jendela selama mengerjakan <strong>dilaporkan ke dosen</strong>.</li>' +
        '<li>Waktu pengerjaan diukur dari kartu ini dibuka hingga tombol kumpul ditekan.</li>' +
        '</ul>' +
        '<button class="btn-sim" id="evStart" style="background:var(--amber-400);">Mulai Evaluasi →</button>' +
        '</div>';
      document.getElementById('evNav').innerHTML = '';
      var b = document.getElementById('evStart');
      if (b) b.addEventListener('click', function () { stage = 'quiz'; current = 0; savePos(); draw(); });
    }

    function drawQuestion() {
      var q = questions[current];
      var card = document.getElementById('evCard');
      var html = '<div class="ev-card__no">SOAL ' + (current + 1) + ' / ' + questions.length + '</div>' +
        '<p class="ev-card__q">' + esc(q.soal) + '</p>' +
        '<div class="ev-opts">';
      order[current].forEach(function (orig) {
        var checked = !preview && sel[current] != null && String(sel[current]) === String(orig) ? ' checked' : '';
        var disabled = preview ? ' disabled' : '';
        html += '<label class="ev-opt' + (checked ? ' sel' : '') + '" data-qi="' + current + '" data-orig="' + orig + '">' +
          '<input type="radio" name="ev_opt" value="' + orig + '"' + checked + disabled + '>' +
          '<span class="ev-opt__label">' + esc(q.opsi[orig]) + '</span></label>';
      });
      html += '</div>';
      card.innerHTML = html;

      var isLast = current === questions.length - 1;
      var nav = document.getElementById('evNav');
      var right = '';
      if (current > 0) right += '<button class="btn-sim" id="evPrev" style="background:var(--navy-800);">‹ Sebelumnya</button>';
      if (isLast && preview) {
        right += '<button class="btn-sim" id="evRestart" style="background:var(--navy-800);">⟲ Awal</button>';
      } else if (isLast) {
        right += '<button class="btn-sim" id="evSubmit" style="background:var(--amber-400);">Kumpulkan Evaluasi</button>';
      } else {
        right += '<button class="btn-sim" id="evNext" style="background:var(--green-600);">Selanjutnya ›</button>';
      }
      nav.innerHTML = '<span id="evPos"></span><div class="ev-nav__right">' + right + '</div>';

      var left = document.getElementById('evPos');
      if (left) left.textContent = (preview ? 'Pratinjau · ' : 'Soal ') + (current + 1) + ' dari ' + questions.length;
    }

    function bindCard() {
      var card = document.getElementById('evCard');
      if (!card) return;
      if (!preview) {
        card.querySelectorAll('.ev-opt').forEach(function (lab) {
          lab.addEventListener('click', function () {
            var qi = parseInt(lab.getAttribute('data-qi'), 10);
            var orig = parseInt(lab.getAttribute('data-orig'), 10);
            sel[qi] = orig;
            card.querySelectorAll('.ev-opt').forEach(function (o) { o.classList.remove('sel'); });
            lab.classList.add('sel');
            savePos();
            updateTrack();
          });
        });
      }
      var prev = document.getElementById('evPrev');
      if (prev) prev.addEventListener('click', function () { if (current > 0) { current--; savePos(); draw(); } });
      var next = document.getElementById('evNext');
      if (next) next.addEventListener('click', function () { if (current < questions.length - 1) { current++; savePos(); draw(); } });
      var rs = document.getElementById('evRestart');
      if (rs) rs.addEventListener('click', function () { current = 0; draw(); });
      var sb = document.getElementById('evSubmit');
      if (sb) sb.addEventListener('click', submit);
    }

    function answeredCount() {
      return Object.keys(sel).filter(function (qi) { return sel[qi] != null; }).length;
    }

    function updateTrack() {
      var prog = document.getElementById('evProg');
      var cnt = document.getElementById('evProgCnt');
      var bar = document.getElementById('evBar');
      if (stage === 'intro') {
        if (prog) prog.textContent = 'Pengantar';
        if (cnt) cnt.textContent = '0 / ' + questions.length;
        if (bar) bar.style.width = '0%';
        return;
      }
      if (preview) {
        if (prog) prog.textContent = 'Pratinjau (mode admin)';
        if (cnt) cnt.textContent = 'Soal ' + (current + 1) + ' / ' + questions.length;
        if (bar) bar.style.width = (current + 1) / questions.length * 100 + '%';
        return;
      }
      var n = answeredCount();
      if (prog) prog.textContent = 'Evaluasi Pertemuan ' + pertemuanId;
      if (cnt) cnt.textContent = n + ' / ' + questions.length + ' terjawab';
      if (bar) bar.style.width = (current + 1) / questions.length * 100 + '%';
    }

    function draft() {
      try { return JSON.parse(localStorage.getItem(backupKey) || 'null'); } catch (e) { return null; }
    }

    function submit() {
      if (submitting || submitted) return;
      var missing = 0;
      questions.forEach(function (_, qi) { if (sel[qi] == null) missing++; });
      var msg = document.getElementById('evalMsg');
      if (missing > 0) {
        msg.textContent = 'Masih ada ' + missing + ' soal belum dijawab. Periksa kembali.';
        return;
      }
      submitting = true;
      var btn = document.getElementById('evalSubmit');
      btn.disabled = true; btn.textContent = 'Mengumpulkan…';

      var n = questions.length;
      var base = Math.floor(100 / n);
      var rem = 100 - base * n;
      var skor = 0, total = 100;
      var jawaban = [];
      questions.forEach(function (q, qi) {
        jawaban.push(sel[qi]);
        var w = base + (qi < rem ? 1 : 0);
        if (sel[qi] === q.benar) skor += w;
      });

      api('/api/evaluasi.php', {
        method: 'POST',
        body: {
          pertemuan_id: pertemuanId, skor: skor, total: total,
          jumlah_soal: questions.length, jawaban: jawaban,
          paste_count: pasteCount, copy_count: copyCount,
          blur_count: blurCount, time_spent_ms: Date.now() - startedAt
        }
      }).then(function (d) {
        submitting = false;
        if (d.ok) {
          submitted = true;
          try { localStorage.removeItem(backupKey); } catch (e) {}
          showResult(d.data || { skor: skor, total: total, flagged: 0 });
          if (typeof window.APIAuth !== 'undefined' && window.APIAuth.me) window.APIAuth.me(true);
        } else if (d.error && /sudah/.test(d.error || '')) {
          // sudah pernah dikumpulkan -> muat ulang status dari server
          me().then(function (p) {
            var ev = (p.evaluasi || {})[pertemuanId];
            if (ev) showResult({ skor: ev.skor, total: ev.total, flagged: ev.flagged, submitted_at: ev.submitted_at });
            else location.reload();
          });
        } else {
          btn.disabled = false; btn.textContent = 'Kumpulkan Evaluasi';
          msg.textContent = d.error || 'Gagal mengumpulkan evaluasi. Coba lagi.';
        }
      }).catch(function () {
        submitting = false;
        btn.disabled = false; btn.textContent = 'Kumpulkan Evaluasi';
        msg.textContent = 'Gagal terhubung ke server. Periksa jaringan lalu klik Kumpulkan lagi.';
      });
    }

    function flagLabels(flagged) {
      var labels = [];
      if (flagged & 1) labels.push('terdeteksi aktivitas salin/tempel');
      if (flagged & 2) labels.push('sering berpindah tab');
      if (flagged & 4) labels.push('waktu mengerjakan sangat singkat');
      return labels;
    }

    function showResult(ev) {
      isActive = false;
      disarmAntiCheat();
      var pct = ev.total > 0 ? Math.round(ev.skor / ev.total * 100) : 0;
      var html = '<div class="evaluasi__result">' +
        '<div class="big">' + ev.skor + ' / ' + ev.total + '</div>' +
        '<div class="sub">Skor evaluasi pertemuan ' + pertemuanId + ' · ' + pct +
        '%' + (ev.submitted_at ? ' · dikumpulkan ' + String(ev.submitted_at).slice(0, 10) : '') + '</div>';
      if (ev.flagged) {
        var lab = flagLabels(ev.flagged);
        html += '<div class="evaluasi__warn">Catatan integritas (' + lab.join(', ') +
          '). Ini dilaporkan ke dosen dan dapat memengaruhi penilaian.</div>';
      } else {
        html += '<div class="evaluasi__warn" style="border-color:var(--green-300);background:var(--green-50);color:#14532d;">' +
          'Jawaban sudah tersimpan. Tidak ada kunci jawaban yang ditampilkan; tunggu pengumuman dosen.</div>';
      }
      html += '</div>';
      stateEl.innerHTML = html;
      formEl.innerHTML = '';
      formEl.hidden = true;
    }

    var keepTimer = null;
    function warnKeep(txt) {
      clearTimeout(keepTimer);
      var old = document.getElementById('evKeep');
      if (old) old.remove();
      var d = document.createElement('div');
      d.className = 'ev-keep';
      d.id = 'evKeep';
      d.innerHTML = txt;
      document.body.appendChild(d);
      keepTimer = setTimeout(function () { d.remove(); }, 4200);
    }

    function armAntiCheat() {
      document.addEventListener('paste', onPaste, true);
      document.addEventListener('copy', onCopy, true);
      document.addEventListener('contextmenu', onCtx, true);
      document.addEventListener('visibilitychange', onVis, true);
      window.addEventListener('beforeunload', onUnload);
    }
    function disarmAntiCheat() {
      document.removeEventListener('paste', onPaste, true);
      document.removeEventListener('copy', onCopy, true);
      document.removeEventListener('contextmenu', onCtx, true);
      document.removeEventListener('visibilitychange', onVis, true);
      window.removeEventListener('beforeunload', onUnload);
    }

    function onPaste(e) {
      if (!isActive) return;
      pasteCount++;
      e.preventDefault();
      warnKeep('<b>Menempel (paste) dilarang</b> pada evaluasi dan telah dicatat. Kerjakan dengan pemahaman sendiri.');
    }
    function onCopy(e) {
      if (!isActive) return;
      copyCount++;
      e.preventDefault();
      warnKeep('Aktivitas salin (copy) dicatat pada evaluasi ini.');
    }
    function onCtx(e) {
      if (!isActive) return;
      e.preventDefault();
    }
    function onVis() {
      if (!isActive || document.visibilityState === 'visible') return;
      blurCount++;
      warnKeep('<b>Berpindah tab/jendela dicatat</b>. ' + blurCount + ' kali. Kerjakan secara mandiri, hindari membuka sumber lain.');
    }
    function onUnload(e) {
      if (!isActive || submitted) return;
      var answered = Object.keys(sel).length;
      if (answered < questions.length) {
        e.preventDefault();
        e.returnValue = '';
      }
    }

    function gate(p) {
      if (!p.logged_in) {
        setState('<div class="evaluasi__locked">Evaluasi hanya untuk mahasiswa yang masuk. ' +
          '<a href="/login?next=' + encodeURIComponent(location.pathname) + '">Login</a> untuk melanjutkan.</div>');
        return false;
      }
      if (p.user && p.user.role === 'admin') {
        stateEl.innerHTML = '<div class="evaluasi__locked"><b>Mode admin:</b> pratinjau soal evaluasi satu per satu tanpa penyimpanan. Jawaban dosen tidak direkam.</div>';
        preview = true;
        stage = 'quiz';
        current = 0;
        sel = {};
        formEl.hidden = false;
        draw();
        return false;
      }
      if ((p.progress || {})[pertemuanId] !== 'done') {
        setState('<div class="evaluasi__locked"><b>Evaluasi terkunci.</b> Selesaikan Latihan pertemuan ' +
          pertemuanId + ' (jawab semua soal latihan dengan benar) untuk membuka evaluasi.</div>');
        return false;
      }
      var ev = (p.evaluasi || {})[pertemuanId];
      if (ev) {
        showResult(ev);
        return false;
      }
      return true;
    }

    me().then(function (p) {
      if (gate(p)) renderForm(draft());
    });

