---
import { getCollection } from 'astro:content';

interface Props {
  activeId?: number;
}

const { activeId } = Astro.props;
const allPertemuan = await getCollection('pertemuan');
const sorted = allPertemuan.sort((a, b) => a.data.order - b.data.order);
---

<div class="sidebar__brand">
  <img src="/logo-unipi.png" alt="Logo Universitas Persatuan Islam (UNIPI)" class="sidebar__logo" width="52" height="52" />
  <p class="sidebar__title">Basis Data</p>
  <p class="sidebar__status">S1 Informatika · UNIPI</p>
  <p class="sidebar__sub">Portal materi interaktif mata kuliah Basis Data untuk mahasiswa Program Studi S1 Informatika, Universitas Persatuan Islam (UNIPI) — Semester 3 · Tahun Akademik 2026/2027.</p>
</div>

<div class="sidebar__progress">
  <div class="sidebar__progress-label">
    <span>PROGRES BELAJAR</span>
    <span id="sidebarProgressCount">—</span>
  </div>
  <div class="sidebar__progress-bar">
    <div class="sidebar__progress-fill" id="sidebarProgressFill" style="width:0%"></div>
  </div>
</div>

<div style="padding:8px 12px;">
  <label for="sidebarSearch" class="visually-hidden">Cari materi</label>
  <input 
    type="text" 
    id="sidebarSearch" 
    placeholder="Cari materi..." 
    style="width:100%; padding:8px 12px; border-radius:10px; border:none; background:rgba(255,255,255,.05); color:#F0EFE8; font-family:var(--font-body); font-size:12.5px; box-shadow: inset 3px 3px 6px rgba(0,0,0,.35), inset -3px -3px 6px rgba(255,255,255,.05); outline:none; transition:box-shadow 0.2s;"
  />
</div>

<ul class="sidebar__list" id="sidebarList">
  <li class="row praktikum-link" data-kind="praktikum" data-title="worksheet praktikum perancangan erd">
    <span class="row__pk" style="background:#D8B64C; color:#221A02;">✎</span>
    <span class="row__text">
      <span class="row__num">PRAKTIKUM</span>
      <span class="row__title" style="color:#F0E7C2;">Worksheet Perancangan ERD</span>
    </span>
  </li>
  <li class="row playground-link" data-kind="playground" data-title="sql playground interaktif lab sql query">
    <span class="row__pk" style="background:#2A7A61; color:#F3F1E8;">❯</span>
    <span class="row__text">
      <span class="row__num">LAB</span>
      <span class="row__title" style="color:#A5D6B2;">SQL Playground</span>
    </span>
  </li>
  {sorted.map((p) => (
    <li 
      class={`row ${p.data.locked ? 'locked' : ''} ${p.data.id === activeId ? 'active' : ''}`}
      data-id={p.data.id}
      data-title={p.data.title.toLowerCase()}
      tabindex={p.data.locked ? "-1" : "0"}
      aria-disabled={p.data.locked ? "true" : undefined}
    >
      <span class="row__pk">{String(p.data.id).padStart(2, '0')}</span>
      <span class="row__text">
        <span class="row__num">PERTEMUAN {p.data.id}</span>
        <span class="row__title">
          {p.data.locked ? (p.data.title || 'Belum tersedia') : p.data.title}
        </span>
      </span>
    </li>
  ))}
</ul>

<div class="sidebar__footer">
  <p class="sidebar__credit">&copy; {new Date().getFullYear()} &middot; Developed by Dede Alamsyah</p>
  <div id="accountBox" class="sidebar__account"><p class="muted">Memuat…</p></div>
  <div style="display:flex; align-items:center; gap:8px; margin-top:10px;">
    <button id="themeToggle" class="zoom-btn" style="width:100%; padding:8px 12px; background:#1C3B30; color:#F3F1E8; border:1px solid rgba(255,255,255,.06); font-size:12px; cursor:pointer; border-radius:10px; display:flex; align-items:center; justify-content:center; gap:6px; box-shadow:none;">
      <span id="themeIcon">🌙</span> <span id="themeText">Dark Mode</span>
    </button>
  </div>
</div>

<script is:inline>
  // Sidebar Search
  const sidebarSearch = document.getElementById('sidebarSearch');
  const sidebarList = document.getElementById('sidebarList');
  
  if (sidebarSearch && sidebarList) {
    sidebarSearch.addEventListener('input', function() {
      const filter = this.value.toLowerCase();
      const rows = sidebarList.querySelectorAll('.row');
      rows.forEach(row => {
        const title = row.getAttribute('data-title') || '';
        row.style.display = title.includes(filter) ? '' : 'none';
      });
    });
  }

  // Sidebar Navigation
  const rows = document.querySelectorAll('.row:not(.locked)');
  rows.forEach(row => {
    row.addEventListener('click', function() {
      const kind = this.getAttribute('data-kind');
      if (kind === 'praktikum') {
        window.location.href = '/praktikum';
        return;
      }
      if (kind === 'playground') {
        window.location.href = '/playground';
        return;
      }
      const id = this.getAttribute('data-id');
      window.location.href = `/pertemuan/${id}`;
    });
  });

  // Active state for praktikum link
  if (window.location.pathname.includes('/praktikum')) {
    const pk = document.querySelector('.praktikum-link');
    if (pk) pk.classList.add('active');
  }
  if (window.location.pathname.includes('/playground')) {
    const pg = document.querySelector('.playground-link');
    if (pg) pg.classList.add('active');
  }
</script>
