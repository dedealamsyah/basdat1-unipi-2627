---
import { getCollection } from 'astro:content';

interface Props {
  activeId?: number;
}

const { activeId } = Astro.props;
const allPertemuan = await getCollection('pertemuan');
const sorted = allPertemuan.sort((a, b) => a.data.order - b.data.order);
---

<div class="sidebar__brand">
  <img src="/logo-unipi.png" alt="Logo Universitas Persatuan Islam (UNIPI)" class="sidebar__logo" width="52" height="52" />
  <p class="sidebar__title">Basis Data</p>
  <p class="sidebar__status">S1 Informatika · UNIPI</p>
</div>

<div class="sidebar__progress">
  <div class="sidebar__progress-label">
    <span>PROGRES BELAJAR</span>
    <span id="sidebarProgressCount">–</span>
  </div>
  <div class="sidebar__progress-bar">
    <div class="sidebar__progress-fill" id="sidebarProgressFill" style="width:0%"></div>
  </div>
</div>

<!-- Pengingat ringkas: hanya mahasiswa. Rinciannya ada di panel lonceng. -->
<div id="notifBox" class="sidebar__notif" data-level="aman" hidden>
  <span class="sidebar__notif-icon" aria-hidden="true">!</span>
  <span id="notifList" class="sidebar__notif-text"></span>
</div>

<div class="sidebar__search">
  <label for="sidebarSearch" class="visually-hidden">Cari materi</label>
  <input 
    type="text" 
    id="sidebarSearch" 
    class="sidebar__search-input"
    placeholder="Cari materi..."
  />
</div>

<nav class="sidebar__nav" aria-label="Navigasi utama">
  <ul class="sidebar__list sidebar__list--plain" id="sidebarMain">
    <li class="row row--plain home-link" data-kind="home" data-title="beranda dashboard ringkasan">
      <span class="row__pk row__pk--ghost" aria-hidden="true">⌂</span>
      <span class="row__text">
        <span class="row__num">BERANDA</span>
        <span class="row__title">Ringkasan belajar</span>
      </span>
    </li>
  </ul>

  <p class="sidebar__group">ALAT BANTU</p>
  <ul class="sidebar__list sidebar__list--plain" id="sidebarTools">
    <li class="row row--plain praktikum-link" data-kind="praktikum" data-title="worksheet praktikum perancangan erd">
      <span class="row__pk row__pk--ghost" aria-hidden="true">✎</span>
      <span class="row__text">
        <span class="row__num">PRAKTIKUM</span>
        <span class="row__title">Worksheet Perancangan ERD</span>
      </span>
    </li>
    <li class="row row--plain playground-link" data-kind="playground" data-title="sql playground interaktif lab sql query">
      <span class="row__pk row__pk--ghost" aria-hidden="true">❯</span>
      <span class="row__text">
        <span class="row__num">LAB</span>
        <span class="row__title">SQL Playground</span>
      </span>
    </li>
    <li class="row row--plain timeline-link" data-kind="timeline" data-title="timeline perjalanan semester peta minggu rps">
      <span class="row__pk row__pk--ghost" aria-hidden="true">≡</span>
      <span class="row__text">
        <span class="row__num">RENCANA</span>
        <span class="row__title">Timeline Perkuliahan</span>
      </span>
    </li>
  </ul>

  <p class="sidebar__group">MATERI</p>
  <ul class="sidebar__list" id="sidebarList">
    {sorted.map((p) => (
      <li
        class={`row ${p.data.locked ? 'locked' : ''} ${p.data.id === activeId ? 'active' : ''}`}
        data-id={p.data.id}
        data-title={p.data.title.toLowerCase()}
        tabindex={p.data.locked ? "-1" : "0"}
        aria-disabled={p.data.locked ? "true" : undefined}
      >
        <span class="row__pk">{String(p.data.id).padStart(2, '0')}</span>
        <span class="row__text">
          <span class="row__num">PERTEMUAN {p.data.id}</span>
          <span class="row__title">
            {p.data.locked ? (p.data.title || 'Belum tersedia') : p.data.title}
          </span>
        </span>
        <span class="row__flag" data-flag=""></span>
      </li>
    ))}
  </ul>
</nav>

<div class="sidebar__footer">
  <div id="accountBox" class="sidebar__account"><p class="muted">Memuat…</p></div>
  <button id="themeToggle" class="theme-btn">
    <span id="themeIcon">🌙</span> <span id="themeText">Dark Mode</span>
  </button>
  <p class="sidebar__credit">© {new Date().getFullYear()} · Dede Alamsyah · UNIPI</p>
</div>

<script is:inline>
  // Pencarian materi: menyaring semua daftar di sidebar (utama, alat, materi).
  (function () {
    const input = document.getElementById('sidebarSearch');
    if (!input) return;
    input.addEventListener('input', function () {
      const q = this.value.trim().toLowerCase();
      document.querySelectorAll('#sidebarList .row, #sidebarTools .row, #sidebarMain .row').forEach(function (row) {
        const haystack = ((row.getAttribute('data-title') || '') + ' ' +
          (row.getAttribute('data-id') || '') + ' ' + row.textContent).toLowerCase();
        const cocok = !q || haystack.indexOf(q) !== -1;
        row.style.display = cocok ? '' : 'none';
      });
    });
  })();

  // Navigasi sidebar.
  (function () {
    document.querySelectorAll('.sidebar .row').forEach(function (row) {
      if (row.classList.contains('locked')) return;
      row.addEventListener('click', function () {
        const kind = this.getAttribute('data-kind');
        if (kind === 'home') { location.href = '/'; return; }
        if (kind === 'praktikum') { location.href = '/praktikum'; return; }
        if (kind === 'playground') { location.href = '/playground'; return; }
        if (kind === 'timeline') { location.href = '/timeline'; return; }
        const id = this.getAttribute('data-id');
        if (id) location.href = '/pertemuan/' + id;
      });
    });

    // Tandai menu yang sedang aktif.
    const path = location.pathname;
    const aktif = [
      ['/praktikum', '.praktikum-link'],
      ['/playground', '.playground-link'],
      ['/timeline', '.timeline-link']
    ];
    aktif.forEach(function (pair) {
      if (path.indexOf(pair[0]) === 0) {
        const el = document.querySelector(pair[1]);
        if (el) el.classList.add('active');
      }
    });
    if (path === '/' || path === '') {
      const el = document.querySelector('.home-link');
      if (el) el.classList.add('active');
    }
  })();
</script>
