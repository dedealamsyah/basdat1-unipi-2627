{
  "name": "portal-basis-data-unipi",
  "type": "module",
  "version": "1.0.0",
  "description": "Portal Materi Interaktif Basis Data - UNIPI",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "gen-kunci": "node scripts/gen-kunci.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "test:notif": "php scripts/test-rekap.php",
    "test:api": "php scripts/test-endpoints.php",
    "test:layout": "python3 scripts/test-sidebar.py",
    "test:sort": "node scripts/test-urutan-sidebar.cjs",
    "test:mhs": "node scripts/test-mhs-ui.cjs",
    "test:praktikum": "node scripts/test-praktikum.cjs",
    "test": "npm run test:api && npm run test:notif && npm run test:layout && npm run test:sort && npm run test:mhs && npm run test:praktikum",
    "dev": "node scripts/gen-kunci.mjs && astro dev",
    "build": "node scripts/gen-kunci.mjs && astro build && node scripts/verify-build.mjs",
    "check": "node scripts/gen-kunci.mjs && astro check",
    "deploy:prep": "node scripts/build-deploy.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "astro": "^7.2.8",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
