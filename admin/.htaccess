Options -Indexes
DirectoryIndex index.php index.html

# Semua file kecuali index.php TIDAK boleh diakses via URL.
# PHP membaca panel.html via file_get_contents (di sisi server, tak terpengaruh).
# Dual-sintaks: Apache 2.4 `Require` dan 2.2 `Order`.
<FilesMatch "^(?!(index\.php$)).+">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    order allow,deny
    deny from all
  </IfModule>
</FilesMatch>
